# Stage these locations before the maintenance switch. The final browser bundle
# moves all reads and writes together; Nginx performs no percentage routing.
location = /healthz {
    proxy_pass http://127.0.0.1:10089/healthz;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
}

location = /readyz {
    proxy_pass http://127.0.0.1:10089/readyz;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
}

location /api/v1/ {
    proxy_pass http://127.0.0.1:10089;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
}
