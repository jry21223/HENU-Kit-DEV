# Put these exact-match/longest-prefix locations before the legacy /api/ proxy.
# The browser controls the stable read cohort; Nginx never sends legacy-contract
# requests to the Go API by percentage.
location = /healthz {
    proxy_pass http://127.0.0.1:10089/healthz;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
}

location = /readyz {
    proxy_pass http://127.0.0.1:10089/readyz;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
}

location /api/v1/ {
    proxy_pass http://127.0.0.1:10089;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
}
