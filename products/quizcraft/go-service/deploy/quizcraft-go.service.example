[Unit]
Description=QuizCraft Go API
After=network-online.target postgresql.service quizcraft-cn.service
Wants=network-online.target

[Service]
Type=simple
User=www-data
Group=www-data
EnvironmentFile=/etc/quizcraft-go.env
ExecStart=/opt/quizcraft-go/releases/current/quizcraft-server
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
