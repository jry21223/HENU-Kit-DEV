    "layers": [
      {
        "kind": "listening",
        "layer": "english",
        "segments": [
          {
            "segment_id": "s1",
            "text": "The North Wind and the Sun were disputing which was the stronger, when a traveler came along wrapped in a warm cloak."
          },
          {
            "segment_id": "s2",
            "text": "They agreed that the one who first succeeded in making the traveler take his cloak off should be considered stronger than the other."
          },
          {
            "segment_id": "s3",
            "text": "Then the North Wind blew as hard as he could, but the more he blew the more closely did the traveler fold his cloak around him; and at last the North Wind gave up the attempt."
          },
          {
            "segment_id": "s4",
            "text": "Then the Sun shone out warmly, and immediately the traveler took off his cloak."
          },
          {
            "segment_id": "s5",
            "text": "And so the North Wind was obliged to confess that the Sun was the stronger of the two."
          }
        ]
      },
      {
        "kind": "listening",
        "layer": "chinese",
        "segments": [
          {
            "segment_id": "s1",
            "text": "北风和太阳正在争论谁更强，一位裹着暖和斗篷的旅人恰好走来。"
          },
          {
            "segment_id": "s2",
            "text": "他们约定，谁先让旅人脱下斗篷，谁就算比对方更强。"
          },
          {
            "segment_id": "s3",
            "text": "于是北风使劲地吹，但风越大，旅人就把斗篷裹得越紧；最后北风放弃了尝试。"
          },
          {
            "segment_id": "s4",
            "text": "接着，太阳温暖地照耀着，旅人立刻脱下了斗篷。"
          },
          {
            "segment_id": "s5",
            "text": "因此，北风不得不承认，太阳是两者中更强的那个。"
          }
        ]
      }
    ]
