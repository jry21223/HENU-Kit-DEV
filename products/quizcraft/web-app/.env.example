# Vite variables are embedded into browser bundles and must contain public values only.
# Never define VITE_ADMIN_TOKEN here; browser admin access uses /api/admin/session.
VITE_API_BASE_URL=/api
VITE_APP_MODE=full
# QuizCraft Go shadow mode talks only to the generated API client. The login URL
# must be a business-site backend entry that validates/stores same-site return_to.
VITE_QUIZCRAFT_GO_SHADOW=0
# Roll out GET /api/v1/banks to a stable browser cohort before enabling writes.
VITE_QUIZCRAFT_GO_READ_PERCENT=0
# Set only after the stop-write/catch-up/snapshot gate passes.
VITE_QUIZCRAFT_GO_WRITES=0
VITE_QUIZCRAFT_GO_API_BASE_URL=
VITE_QUIZCRAFT_LOGIN_URL=/auth/login
