+// A tenant whose merchant order number must stay private gets no
+// gateway-hosted checkout page: that page's URL carries the order number. Such
+// a tenant receives WeChat's own `weixin://` payment URI instead, which is a
+// single-use code carrying no merchant order number.
+function hostsOwnCheckoutPage(merchant) {
+  return !merchant || merchant.hostedCheckout !== false;
+}
+
+function checkoutURLFor(merchant, outTradeNo, wechatCodeUrl) {
+  if (hostsOwnCheckoutPage(merchant)) {
+    return `${config.siteDomain}/pay/${outTradeNo}`;
+  }
+  return wechatCodeUrl || "";
+}
