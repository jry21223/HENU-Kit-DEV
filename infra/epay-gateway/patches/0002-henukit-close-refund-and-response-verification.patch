+    assert.equal(response.status, 404);
+    assert.equal(calls.refund.length, 0);
+    assert.equal(store.get(METAVIEW_ORDER).refund, undefined);
+  });
+});
+
+test("refund uses the stored amount and is idempotent for one refund number", async () => {
+  await withServer(async (server) => {
+    const params = { pid: "2001", out_trade_no: HENU_ORDER, out_refund_no: "HNKREFUND0001" };
+    const first = await post(server, "/api/refund.php", params, "henukit-test-secret");
+    assert.equal(first.status, 200);
+    const body = await first.json();
+    assert.equal(verify(body, "henukit-test-secret"), true);
+    assert.equal(body.refund_status, "processing");
+
+    // The caller never supplies an amount; it comes from the stored order.
+    assert.equal(calls.refund.length, 1);
+    assert.equal(calls.refund[0].refundCents, 990);
+    assert.equal(calls.refund[0].totalCents, 990);
