+    for (const name of fs.readdirSync(dir).sort()) {
+      if (!/\.(pem|crt|cer)$/i.test(name)) continue;
+      try {
+        pems.push(fs.readFileSync(path.join(dir, name), "utf-8"));
+      } catch { /* skip unreadable file */ }
+    }
+  }
+  const single = getPlatformCert();
+  if (single) pems.push(single);
+
+  for (const pem of pems) {
+    if (!pem || !pem.includes("BEGIN CERTIFICATE")) continue;
+    try {
+      const serial = new crypto.X509Certificate(pem).serialNumber;
+      if (serial) _platformCerts[String(serial).toUpperCase()] = pem;
+    } catch { /* not a parseable certificate — skip */ }
+  }
+  return _platformCerts;
