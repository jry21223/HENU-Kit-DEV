+process.env.WECHAT_APPID = "wx-henukit-test";
+
+const { WeChatPayClient } = require("../lib/wechat");
+
+// Authoritative trade state per order. WeChat never walks an order back from
+// SUCCESS, so each order keeps one stable state for the whole run.
+const tradeStates = new Map();
+const calls = { close: [], refund: [], queryRefund: [] };
+
+WeChatPayClient.prototype.queryOrder = async (outTradeNo) => ({
+  mchid: "1900000109",
+  appid: "wx-henukit-test",
+  out_trade_no: outTradeNo,
+  transaction_id: "42000000000000000001",
+  trade_state: tradeStates.get(outTradeNo) || "SUCCESS",
+  success_time: "2026-07-30T13:43:08Z",
+  amount: { total: 990, currency: "CNY" },
+});
+WeChatPayClient.prototype.closeOrder = async (outTradeNo) => {
+  calls.close.push(outTradeNo);
+};
+WeChatPayClient.prototype.refund = async (request) => {
+  calls.refund.push(request);
+  return {
+    refund_id: "50000000382019052709732678859",
+    out_refund_no: request.outRefundNo,
+    out_trade_no: request.outTradeNo,
+    status: "PROCESSING",
+  };
+};
+WeChatPayClient.prototype.queryRefund = async (outRefundNo) => {
+  calls.queryRefund.push(outRefundNo);
+  return {
+    refund_id: "50000000382019052709732678859",
+    out_refund_no: outRefundNo,
+    out_trade_no: "HNKABCDEFGHIJKLMNOPQRSTUVWXYZ234",
+    status: "SUCCESS",
+  };
+};
+
+const { sign, verify } = require("../lib/epay");
+const { app, store } = require("../server");
+
+const HENU_ORDER = "HNKABCDEFGHIJKLMNOPQRSTUVWXYZ234";
+const METAVIEW_ORDER = "MV20260730120000";
+
+function seed() {
+  store.create({
+    out_trade_no: HENU_ORDER,
+    pid: "2001",
+    pay_type: "wxpay",
+    amount_yuan: "9.90",
+    amount_cents: 990,
+    name: "HENU Kit lifetime membership",
+    notify_url: "https://henukit.cn/api/v1/payment-providers/easypay/notifications",
+    return_url: "https://henukit.cn/account/membership",
+  });
+  store.create({
+    out_trade_no: METAVIEW_ORDER,
+    pid: "1001",
+    pay_type: "wxpay",
+    amount_yuan: "128.00",
+    amount_cents: 12800,
+    name: "MetaView order",
+    notify_url: "https://metaview.top/notify",
+    return_url: "https://metaview.top/return",
+  });
+}
+
+async function post(server, route, params, key) {
+  const signed = { ...params };
+  signed.sign = sign(signed, key);
+  signed.sign_type = "MD5";
+  return fetch(`http://127.0.0.1:${server.address().port}${route}`, {
+    method: "POST",
+    headers: { "Content-Type": "application/x-www-form-urlencoded" },
+    body: new URLSearchParams(signed),
+  });
+}
+
+async function withServer(run) {
+  const server = app.listen(0, "127.0.0.1");
+  await new Promise((resolve) => server.once("listening", resolve));
+  try {
+    await run(server);
+  } finally {
+    await new Promise((resolve) => server.close(resolve));
+  }
+}
+
+test.after(() => fs.rmSync(directory, { recursive: true, force: true }));
+
+test("a tenant cannot refund another tenant's order", async () => {
+  seed();
+  await withServer(async (server) => {
+    // HENU Kit credentials pointed at the MetaView order.
+    const response = await post(
+      server,
+      "/api/refund.php",
+      { pid: "2001", out_trade_no: METAVIEW_ORDER, out_refund_no: "HNKREFUND0001" },
+      "henukit-test-secret"
