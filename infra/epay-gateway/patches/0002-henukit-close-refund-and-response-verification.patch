+      "/api/refund.php",
+      { pid: "2001", out_trade_no: HENU_ORDER, out_refund_no: "HNKREFUND0002" },
+      "henukit-test-secret"
+    );
+    assert.equal(second.status, 409);
+    assert.equal(calls.refund.length, 1);
+  });
+});
+
+test("refund status query reconciles the durable refund to the authoritative result", async () => {
+  await withServer(async (server) => {
+    const response = await post(
+      server,
+      "/api/refund-query.php",
+      { pid: "2001", out_trade_no: HENU_ORDER, out_refund_no: "HNKREFUND0001" },
+      "henukit-test-secret"
+    );
+    assert.equal(response.status, 200);
+    const body = await response.json();
+    assert.equal(verify(body, "henukit-test-secret"), true);
+    assert.equal(body.refund_status, "succeeded");
+    assert.equal(store.get(HENU_ORDER).status, "refunded");
+    assert.equal(calls.queryRefund.length, 1);
+  });
+});
+
+test("a paid order is never closed, and an unpaid one closes exactly once", async () => {
+  const paidOrder = "HNKPAID00000000000000000000000AB";
+  const unpaidOrder = "HNKUNPAID000000000000000000000AB";
+  for (const id of [paidOrder, unpaidOrder]) {
+    store.create({
+      out_trade_no: id,
+      pid: "2001",
+      pay_type: "wxpay",
+      amount_yuan: "9.90",
+      amount_cents: 990,
+      name: "HENU Kit lifetime membership",
+      notify_url: "https://henukit.cn/api/v1/payment-providers/easypay/notifications",
+      return_url: "https://henukit.cn/account/membership",
+    });
+  }
+  tradeStates.set(paidOrder, "SUCCESS");
+  tradeStates.set(unpaidOrder, "NOTPAY");
+
+  await withServer(async (server) => {
+    // WeChat reports SUCCESS, so closing must be refused and the payment fact
+    // recorded rather than discarded.
+    const paid = await post(
+      server,
+      "/api/close.php",
+      { pid: "2001", out_trade_no: paidOrder },
+      "henukit-test-secret"
+    );
+    assert.equal(paid.status, 409);
+    assert.equal(calls.close.length, 0);
+    assert.equal(store.get(paidOrder).status, "paid");
+
+    const closed = await post(
+      server,
+      "/api/close.php",
+      { pid: "2001", out_trade_no: unpaidOrder },
+      "henukit-test-secret"
+    );
+    assert.equal(closed.status, 200);
+    const body = await closed.json();
+    assert.equal(verify(body, "henukit-test-secret"), true);
+    assert.equal(body.trade_status, "TRADE_CLOSED");
+    assert.equal(store.get(unpaidOrder).status, "closed");
+    assert.equal(calls.close.length, 1);
+
+    // Closing again is safe and does not re-issue the WeChat call.
+    const again = await post(
+      server,
+      "/api/close.php",
+      { pid: "2001", out_trade_no: unpaidOrder },
+      "henukit-test-secret"
+    );
+    assert.equal(again.status, 200);
+    assert.equal(calls.close.length, 1);
+  });
+});
diff --git a/test/wechat-close-refund.test.js b/test/wechat-close-refund.test.js
--- a/test/wechat-close-refund.test.js	1970-01-01 08:00:00
+++ b/test/wechat-close-refund.test.js	2026-07-31 11:33:42
@@ -0,0 +1,229 @@
+const assert = require("node:assert/strict");
+const crypto = require("node:crypto");
+const http = require("node:http");
+const test = require("node:test");
+const { WeChatPayClient } = require("../lib/wechat");
+
+const PLATFORM_SERIAL = "5157F09EFDC096DE15EBE81A47057A72";
+
+function signResponse(response, body, platformKey, serial = PLATFORM_SERIAL) {
+  const timestamp = String(Math.floor(Date.now() / 1000));
+  const nonce = crypto.randomBytes(16).toString("hex");
+  const signer = crypto.createSign("SHA256");
+  signer.update(`${timestamp}\n${nonce}\n${body}\n`);
+  signer.end();
+  response.setHeader("Wechatpay-Timestamp", timestamp);
+  response.setHeader("Wechatpay-Nonce", nonce);
+  response.setHeader("Wechatpay-Serial", serial);
+  response.setHeader("Wechatpay-Signature", signer.sign(platformKey, "base64"));
+}
+
+function newKeys() {
+  const merchant = crypto.generateKeyPairSync("rsa", { modulusLength: 2048 });
+  const platform = crypto.generateKeyPairSync("rsa", { modulusLength: 2048 });
+  return {
+    merchantPrivateKey: merchant.privateKey.export({ type: "pkcs8", format: "pem" }),
+    platformPrivateKey: platform.privateKey,
+    platformCert: platform.publicKey.export({ type: "spki", format: "pem" }),
+  };
+}
+
+async function withServer(handler, run, clientOverrides = {}) {
+  const keys = newKeys();
+  const server = http.createServer((request, response) => handler(request, response, keys));
+  await new Promise((resolve) => server.listen(0, "127.0.0.1", resolve));
+  try {
+    const client = new WeChatPayClient({
+      wechatAppId: "wx-test",
+      wechatMchId: "1900000109",
+      wechatSerialNo: "merchant-serial",
+      wechatPrivateKey: keys.merchantPrivateKey,
+      wechatPlatformCert: keys.platformCert,
+      wechatApiBase: `http://127.0.0.1:${server.address().port}`,
+      ...clientOverrides(keys),
+    });
+    await run(client, keys);
+  } finally {
+    await new Promise((resolve) => server.close(resolve));
+  }
+}
+
+const noOverrides = () => ({});
+
+test("close posts mchid to the close path and accepts WeChat's empty 204", async () => {
+  let seen = null;
+  await withServer(
+    (request, response) => {
+      let body = "";
+      request.on("data", (chunk) => { body += chunk; });
+      request.on("end", () => {
+        seen = { url: request.url, method: request.method, body: JSON.parse(body) };
+        response.statusCode = 204;
+        response.end();
+      });
+    },
+    async (client) => {
+      const result = await client.closeOrder("HNKABCDEFGHIJKLMNOPQRSTUVWXYZ234");
+      assert.equal(result, undefined);
+    },
+    noOverrides
+  );
+  assert.equal(seen.method, "POST");
+  assert.equal(
+    seen.url,
+    "/v3/pay/transactions/out-trade-no/HNKABCDEFGHIJKLMNOPQRSTUVWXYZ234/close"
+  );
+  assert.deepEqual(seen.body, { mchid: "1900000109" });
+});
+
+test("refund sends fen amounts and the caller's idempotent refund correlation", async () => {
+  let seen = null;
+  await withServer(
+    (request, response, keys) => {
+      let body = "";
+      request.on("data", (chunk) => { body += chunk; });
+      request.on("end", () => {
+        seen = { url: request.url, method: request.method, body: JSON.parse(body) };
+        const payload = JSON.stringify({
+          refund_id: "50000000382019052709732678859",
+          out_refund_no: "HNKREFUND0001",
+          out_trade_no: "HNKABCDEFGHIJKLMNOPQRSTUVWXYZ234",
+          status: "PROCESSING",
+        });
+        signResponse(response, payload, keys.platformPrivateKey);
+        response.end(payload);
+      });
+    },
+    async (client) => {
+      const result = await client.refund({
+        outTradeNo: "HNKABCDEFGHIJKLMNOPQRSTUVWXYZ234",
+        outRefundNo: "HNKREFUND0001",
+        refundCents: 990,
+        totalCents: 990,
+        reason: "operator refund",
+      });
+      assert.equal(result.status, "PROCESSING");
+    },
+    noOverrides
+  );
+  assert.equal(seen.method, "POST");
+  assert.equal(seen.url, "/v3/refund/domestic/refunds");
+  assert.equal(seen.body.out_refund_no, "HNKREFUND0001");
+  assert.deepEqual(seen.body.amount, { refund: 990, total: 990, currency: "CNY" });
+});
+
+test("refund query is an authenticated GET with no body", async () => {
+  let seen = null;
+  await withServer(
+    (request, response, keys) => {
+      let body = "";
+      request.on("data", (chunk) => { body += chunk; });
+      request.on("end", () => {
+        seen = { url: request.url, method: request.method, body };
+        const payload = JSON.stringify({
+          out_refund_no: "HNKREFUND0001",
+          out_trade_no: "HNKABCDEFGHIJKLMNOPQRSTUVWXYZ234",
+          status: "SUCCESS",
+        });
+        signResponse(response, payload, keys.platformPrivateKey);
+        response.end(payload);
+      });
+    },
+    async (client) => {
+      const result = await client.queryRefund("HNKREFUND0001");
+      assert.equal(result.status, "SUCCESS");
+    },
+    noOverrides
+  );
+  assert.equal(seen.method, "GET");
+  assert.equal(seen.url, "/v3/refund/domestic/refunds/HNKREFUND0001");
+  assert.equal(seen.body, "");
+});
+
+test("an unsigned response body is rejected instead of trusted", async () => {
+  await withServer(
+    (request, response) => {
+      request.on("data", () => {});
+      request.on("end", () => {
+        response.setHeader("Content-Type", "application/json");
+        response.end(JSON.stringify({ status: "SUCCESS" }));
+      });
+    },
+    async (client) => {
+      await assert.rejects(
+        () => client.queryRefund("HNKREFUND0001"),
+        /response body was not signed/
+      );
+    },
+    noOverrides
+  );
+});
+
+test("a response signed by the wrong key is rejected", async () => {
+  await withServer(
+    (request, response) => {
+      const impostor = crypto.generateKeyPairSync("rsa", { modulusLength: 2048 });
+      request.on("data", () => {});
+      request.on("end", () => {
+        const payload = JSON.stringify({ status: "SUCCESS" });
+        signResponse(response, payload, impostor.privateKey);
+        response.end(payload);
+      });
+    },
+    async (client) => {
+      await assert.rejects(
+        () => client.queryRefund("HNKREFUND0001"),
+        /bad signature for platform serial/
+      );
+    },
+    noOverrides
+  );
+});
+
+test("the platform key is selected by Wechatpay-Serial so rotation is config-only", async () => {
+  const rotated = crypto.generateKeyPairSync("rsa", { modulusLength: 2048 });
+  const rotatedSerial = "7A0EDC0F5B2C4A118E5D6F3B9C1A2D4E";
+  await withServer(
+    (request, response) => {
+      request.on("data", () => {});
+      request.on("end", () => {
+        // WeChat has rotated: it now signs with the newer serial's key.
+        const payload = JSON.stringify({ status: "SUCCESS" });
+        signResponse(response, payload, rotated.privateKey, rotatedSerial);
+        response.end(payload);
+      });
+    },
+    async (client) => {
+      const result = await client.queryRefund("HNKREFUND0001");
+      assert.equal(result.status, "SUCCESS");
+    },
+    // Both the outgoing and the incoming certificate are staged, so the
+    // rotation verifies without a redeploy.
+    (keys) => ({
+      wechatPlatformCerts: {
+        [PLATFORM_SERIAL]: keys.platformCert,
+        [rotatedSerial]: rotated.publicKey.export({ type: "spki", format: "pem" }),
+      },
+    })
+  );
+});
+
+test("an unknown platform serial fails closed rather than falling back", async () => {
+  await withServer(
+    (request, response, keys) => {
+      request.on("data", () => {});
+      request.on("end", () => {
+        const payload = JSON.stringify({ status: "SUCCESS" });
+        signResponse(response, payload, keys.platformPrivateKey, "UNSTAGED-SERIAL");
+        response.end(payload);
+      });
+    },
+    async (client) => {
+      await assert.rejects(
+        () => client.queryRefund("HNKREFUND0001"),
+        /bad signature for platform serial UNSTAGED-SERIAL/
+      );
+    },
+    (keys) => ({ wechatPlatformCerts: { [PLATFORM_SERIAL]: keys.platformCert } })
+  );
+});
