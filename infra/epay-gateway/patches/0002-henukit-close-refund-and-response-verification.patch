+// ── Close / refund ─────────────────────────────────────────────
+//
+// Tenant-signed operator commands. Each one resolves the order only inside the
+// calling tenant, so a merchant can never close or refund another tenant's
+// order. Refund amounts are always taken from the stored order, never from the
+// request.
+
+const WECHAT_REFUND_STATUS = {
+  SUCCESS: "succeeded",
+  CLOSED: "closed",
+  PROCESSING: "processing",
+  ABNORMAL: "abnormal",
+};
+
+function authorizeTenantOrder(req, res) {
+  const params = { ...req.body };
+  const merchant = config.merchants.resolve(params.pid);
+  if (!merchant || !epayVerify(params, merchant.key)) {
+    res.status(400).json({ error: "signature error" });
+    return null;
+  }
+  const order = store.get(params.out_trade_no);
+  if (!order || order.pid !== merchant.pid) {
+    res.status(404).json({ error: "order not found" });
+    return null;
+  }
+  return { params, merchant, order };
+}
+
+function signedJson(res, merchant, payload) {
+  const result = { ...payload };
+  result.sign = epaySign(result, merchant.key);
+  result.sign_type = "MD5";
+  res.json(result);
+}
+
+app.post("/api/close.php", async (req, res) => {
+  const context = authorizeTenantOrder(req, res);
+  if (!context) return;
+  const { merchant, order } = context;
+
+  // Ask WeChat before closing so a paid order can never be closed on the
+  // strength of stale local state.
+  let authoritative;
+  try {
+    authoritative = await wechat.queryOrder(order.out_trade_no);
+  } catch (err) {
+    console.error(`WeChat merchant-order query failed: ${err.message}`);
+    return res.status(502).json({ error: "wechat query failed" });
+  }
+  if (!wechatOrderMatches(order, authoritative) ||
+      authoritative.out_trade_no !== order.out_trade_no) {
+    return res.status(502).json({ error: "wechat query mismatch" });
+  }
+  if (authoritative.trade_state === "SUCCESS") {
+    store.markPaid(order.out_trade_no, authoritative.transaction_id);
+    return res.status(409).json({ error: "order already paid" });
+  }
+
+  if (order.status === "pending") {
+    try {
+      await wechat.closeOrder(order.out_trade_no);
+    } catch (err) {
+      console.error(`WeChat close failed: ${err.message}`);
+      return res.status(502).json({ error: "wechat close failed" });
+    }
+    store.markClosed(order.out_trade_no);
+  }
+
+  const closed = store.get(order.out_trade_no);
+  signedJson(res, merchant, {
+    pid: order.pid,
+    out_trade_no: order.out_trade_no,
+    trade_status: "TRADE_CLOSED",
+    closed_at: closed.closed_at || "",
+  });
+});
+
+app.post("/api/refund.php", async (req, res) => {
+  const context = authorizeTenantOrder(req, res);
+  if (!context) return;
+  const { params, merchant, order } = context;
+  const outRefundNo = String(params.out_refund_no || "");
+  if (!outRefundNo) {
+    return res.status(400).json({ error: "out_refund_no required" });
+  }
+
+  let authoritative;
+  try {
+    authoritative = await wechat.queryOrder(order.out_trade_no);
+  } catch (err) {
+    console.error(`WeChat merchant-order query failed: ${err.message}`);
+    return res.status(502).json({ error: "wechat query failed" });
+  }
+  if (!wechatOrderMatches(order, authoritative) ||
+      authoritative.out_trade_no !== order.out_trade_no) {
+    return res.status(502).json({ error: "wechat query mismatch" });
+  }
+  if (authoritative.trade_state !== "SUCCESS") {
+    return res.status(409).json({ error: "order not paid" });
+  }
+  store.markPaid(order.out_trade_no, authoritative.transaction_id);
+
+  // The refunded amount comes from the stored order, never from the caller.
+  const reservation = store.reserveRefund(order.out_trade_no, outRefundNo, order.amount_cents);
+  if (!reservation) {
+    return res.status(409).json({ error: "order already has a different refund" });
+  }
+
+  // A replay whose refund is already confirmed submitted returns the durable
+  // fact instead of calling WeChat again. A reservation that never recorded a
+  // WeChat refund id is re-submitted, which is safe because `out_refund_no`
+  // makes the WeChat refund itself idempotent — that way a submission lost to a
+  // network failure still completes rather than stranding the refund.
+  let refund = reservation.refund;
+  if (!refund.wechat_refund_id) {
+    let refundResult;
+    try {
+      refundResult = await wechat.refund({
+        outTradeNo: order.out_trade_no,
+        outRefundNo,
+        refundCents: order.amount_cents,
+        totalCents: order.amount_cents,
+        reason: params.reason || "",
+      });
+    } catch (err) {
+      console.error(`WeChat refund failed: ${err.message}`);
+      return res.status(502).json({ error: "wechat refund failed" });
+    }
+    const status = WECHAT_REFUND_STATUS[refundResult.status] || "processing";
+    refund = store.applyRefundStatus(
+      order.out_trade_no, outRefundNo, status, refundResult.refund_id || null
+    );
+  }
+  signedJson(res, merchant, {
+    pid: order.pid,
+    out_trade_no: order.out_trade_no,
+    out_refund_no: outRefundNo,
+    refund_status: refund.status,
+    money: order.amount_yuan,
+  });
+});
+
+app.post("/api/refund-query.php", async (req, res) => {
+  const context = authorizeTenantOrder(req, res);
+  if (!context) return;
+  const { params, merchant, order } = context;
+  const outRefundNo = String(params.out_refund_no || "");
+  if (!order.refund || order.refund.out_refund_no !== outRefundNo) {
+    return res.status(404).json({ error: "refund not found" });
+  }
+
+  let authoritative;
+  try {
+    authoritative = await wechat.queryRefund(outRefundNo);
+  } catch (err) {
+    console.error(`WeChat refund query failed: ${err.message}`);
+    return res.status(502).json({ error: "wechat refund query failed" });
+  }
+  if (authoritative.out_trade_no !== order.out_trade_no) {
+    return res.status(502).json({ error: "wechat refund query mismatch" });
+  }
+
+  const status = WECHAT_REFUND_STATUS[authoritative.status] || "processing";
+  const refund = store.applyRefundStatus(
+    order.out_trade_no, outRefundNo, status, authoritative.refund_id || null
+  );
+  signedJson(res, merchant, {
+    pid: order.pid,
+    out_trade_no: order.out_trade_no,
+    out_refund_no: outRefundNo,
+    refund_status: refund.status,
+    money: order.amount_yuan,
+  });
+});
