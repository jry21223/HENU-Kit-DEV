@@ -0,0 +1,67 @@
+const assert = require("node:assert/strict");
+const fs = require("node:fs");
+const os = require("node:os");
+const path = require("node:path");
+const test = require("node:test");
+
+const directory = fs.mkdtempSync(path.join(os.tmpdir(), "epay-query-route-"));
+process.env.EPAY_DB_PATH = path.join(directory, "orders.json");
+process.env.EPAY_PID = "1001";
+process.env.EPAY_KEY = "metaview-test-secret";
+process.env.HENUKIT_EPAY_PID = "2001";
+process.env.HENUKIT_EPAY_KEY = "henukit-test-secret";
+process.env.HENUKIT_EPAY_ENABLED = "1";
+process.env.WECHAT_MCHID = "1900000109";
+process.env.WECHAT_APPID = "wx-henukit-test";
+
+const { WeChatPayClient } = require("../lib/wechat");
+WeChatPayClient.prototype.queryOrder = async (outTradeNo) => ({
+  mchid: "1900000109",
+  appid: "wx-henukit-test",
+  out_trade_no: outTradeNo,
+  transaction_id: "42000000000000000001",
+  trade_state: "SUCCESS",
+  success_time: "2026-07-30T13:43:08Z",
+  amount: { total: 990, currency: "CNY" },
+});
+const { sign, verify } = require("../lib/epay");
+const { app, store } = require("../server");
+
+test("authoritative query returns once and only enqueues downstream notification", async () => {
+  const orderID = "HNKABCDEFGHIJKLMNOPQRSTUVWXYZ234";
+  store.create({
+    out_trade_no: orderID,
+    pid: "2001",
+    pay_type: "wxpay",
+    amount_yuan: "9.90",
+    amount_cents: 990,
+    name: "HENU Kit lifetime membership",
+    notify_url: "https://henukit.cn/api/v1/payment-providers/easypay/notifications",
+    return_url: "https://henukit.cn/account/membership",
+  });
+  const server = app.listen(0, "127.0.0.1");
+  await new Promise((resolve) => server.once("listening", resolve));
+  try {
+    const params = { pid: "2001", out_trade_no: orderID };
+    params.sign = sign(params, "henukit-test-secret");
+    params.sign_type = "MD5";
+    const response = await fetch(`http://127.0.0.1:${server.address().port}/api/query.php`, {
+      method: "POST",
+      headers: { "Content-Type": "application/x-www-form-urlencoded" },
+      body: new URLSearchParams(params),
+    });
+    assert.equal(response.status, 200);
+    const result = await response.json();
+    assert.equal(result.trade_status, "TRADE_SUCCESS");
+    assert.equal(verify(result, "henukit-test-secret"), true);
+    assert.equal(store.get(orderID).notify_state, "pending");
+    assert.equal(store.dueNotifications(new Date("2030-01-01T00:00:00Z")).length, 1);
+    const browserStatus = await fetch(`http://127.0.0.1:${server.address().port}/api/status/${orderID}`);
+    assert.equal(browserStatus.status, 404);
+    const browserCheckout = await fetch(`http://127.0.0.1:${server.address().port}/pay/${orderID}`);
+    assert.equal(browserCheckout.status, 404);
+  } finally {
+    await new Promise((resolve) => server.close(resolve));
+    fs.rmSync(directory, { recursive: true, force: true });
+  }
+});
