diff --git a/test/query-outbox.test.js b/test/query-outbox.test.js
new file mode 100644
--- /dev/null
+++ b/test/query-outbox.test.js
@@ -0,0 +1,45 @@
+const assert = require("node:assert/strict");
+const fs = require("node:fs");
+const os = require("node:os");
+const path = require("node:path");
+const test = require("node:test");
+const { OrderStore } = require("../lib/db");
+
+test("failed downstream notifications survive restart and become retryable", () => {
+  const directory = fs.mkdtempSync(path.join(os.tmpdir(), "epay-outbox-"));
+  const file = path.join(directory, "orders.json");
+  const store = new OrderStore(file);
+  store.create({
+    out_trade_no: "HNKABCDEFGHIJKLMNOPQRSTUVWXYZ234",
+    pid: "2001",
+    pay_type: "wxpay",
+    amount_yuan: "9.90",
+    amount_cents: 990,
+    name: "HENU Kit lifetime membership",
+    notify_url: "https://henukit.cn/api/v1/payment-providers/easypay/notifications",
+    return_url: "https://henukit.cn/account/membership",
+  });
+  store.markPaid("HNKABCDEFGHIJKLMNOPQRSTUVWXYZ234", "42000000000000000001");
+  store.recordNotifyAttempt("HNKABCDEFGHIJKLMNOPQRSTUVWXYZ234", false, "HTTP 503");
+
+  const restarted = new OrderStore(file);
+  const order = restarted.get("HNKABCDEFGHIJKLMNOPQRSTUVWXYZ234");
+  assert.equal(order.notify_state, "retry");
+  assert.equal(order.notify_attempts, 1);
+  assert.equal(order.last_notify_error, "HTTP 503");
+  order.next_notify_at = "2020-01-01T00:00:00.000Z";
+  restarted._save();
+  assert.equal(restarted.dueNotifications(new Date("2026-07-30T00:00:00Z")).length, 1);
+  restarted.recordNotifyAttempt(order.out_trade_no, true);
+  assert.equal(restarted.dueNotifications(new Date("2030-01-01T00:00:00Z")).length, 0);
+  fs.rmSync(directory, { recursive: true, force: true });
+});
+
+test("order store persists with owner-only permissions", () => {
+  const directory = fs.mkdtempSync(path.join(os.tmpdir(), "epay-mode-"));
+  const file = path.join(directory, "orders.json");
+  const store = new OrderStore(file);
+  store.create({ out_trade_no: "HNKABCDEFGHIJKLMNOPQRSTUVWXYZ234" });
+  assert.equal(fs.statSync(file).mode & 0o777, 0o600);
+  fs.rmSync(directory, { recursive: true, force: true });
+});
diff --git a/test/wechat-query.test.js b/test/wechat-query.test.js
new file mode 100644
--- /dev/null
+++ b/test/wechat-query.test.js
@@ -0,0 +1,45 @@
+const assert = require("node:assert/strict");
+const crypto = require("node:crypto");
+const http = require("node:http");
+const test = require("node:test");
+const { WeChatPayClient } = require("../lib/wechat");
+
+test("merchant-order query uses an authenticated WeChat GET without a body", async () => {
+  const { privateKey } = crypto.generateKeyPairSync("rsa", { modulusLength: 2048 });
+  const server = http.createServer((request, response) => {
+    assert.equal(
+      request.url,
+      "/v3/pay/transactions/out-trade-no/HNKABCDEFGHIJKLMNOPQRSTUVWXYZ234?mchid=1900000109"
+    );
+    assert.equal(request.method, "GET");
+    assert.match(request.headers.authorization, /^WECHATPAY2-SHA256-RSA2048 /);
+    let body = "";
+    request.on("data", (chunk) => { body += chunk; });
+    request.on("end", () => {
+      assert.equal(body, "");
+      response.setHeader("Content-Type", "application/json");
+      response.end(JSON.stringify({
+        out_trade_no: "HNKABCDEFGHIJKLMNOPQRSTUVWXYZ234",
+        transaction_id: "42000000000000000001",
+        trade_state: "SUCCESS",
+        amount: { total: 990, currency: "CNY" },
+      }));
+    });
+  });
+  await new Promise((resolve) => server.listen(0, "127.0.0.1", resolve));
+  try {
+    const address = server.address();
+    const client = new WeChatPayClient({
+      wechatAppId: "wx-test",
+      wechatMchId: "1900000109",
+      wechatSerialNo: "serial-test",
+      wechatPrivateKey: privateKey.export({ type: "pkcs8", format: "pem" }),
+      wechatApiBase: `http://127.0.0.1:${address.port}`,
+    });
+    const order = await client.queryOrder("HNKABCDEFGHIJKLMNOPQRSTUVWXYZ234");
+    assert.equal(order.trade_state, "SUCCESS");
+    assert.equal(order.amount.total, 990);
+  } finally {
+    await new Promise((resolve) => server.close(resolve));
+  }
+});
