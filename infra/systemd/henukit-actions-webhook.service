[Unit]
Description=Notify the HENU Kit automatic release controller
After=henukit-actions-auto-deploy.service

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/usr/bin/systemctl kill --kill-whom=main --signal=USR1 henukit-actions-auto-deploy.service
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
