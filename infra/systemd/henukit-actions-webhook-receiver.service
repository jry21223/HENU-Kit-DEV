[Unit]
Description=Receive HENU Kit release workflow notifications
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=henukit-deploy
Group=henukit-deploy
LoadCredential=webhook_secret:/etc/henukit-deploy/webhook-secret
Environment=HENUKIT_WEBHOOK_SECRET_FILE=%d/webhook_secret
Environment=HENUKIT_WEBHOOK_LISTEN_ADDR=127.0.0.1:10091
Environment=HENUKIT_WEBHOOK_PATH=/webhooks/github
Environment=HENUKIT_WEBHOOK_REPOSITORY=jry21223/HENU-Kit-DEV
Environment=HENUKIT_WEBHOOK_BRANCH=main
Environment=HENUKIT_WEBHOOK_STATE_DIR=/var/lib/henukit-actions-webhook
Environment=HENUKIT_WEBHOOK_MAX_BODY_BYTES=1048576
ExecStart=/usr/local/bin/henukit-deploy-webhook actions-serve
StateDirectory=henukit-actions-webhook
StateDirectoryMode=0750
UMask=0077
Restart=on-failure
RestartSec=5s
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
