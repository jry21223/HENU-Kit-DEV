# HENU Kit full-stack reverse proxy (docker-compose.henukit.yml).
# Mount as /etc/nginx/conf.d/default.conf in the nginx service.
#
# Public surface (primary product path):
#   /            → Portal (apps/portal)
#   /api/        → Portal Gateway
#   /console/    → Console (ops UI; admin only)
#   /quiz/       → QuizCraft web
#   /quiz-api/   → QuizCraft FastAPI
#   /study-api/  → Study API (library backend / debug)
#
# Console Gateway browser API still uses absolute /api/v1/* in the SPA.
# For local full-stack ops, either:
#   - open console-gateway on host :8082, or
#   - put Console on its own host later.
# This edge keeps /api/ as the Portal public BFF per product topology.

upstream henukit_portal {
    server portal:3001;
}

upstream henukit_portal_gateway {
    server portal-gateway:8084;
}

upstream henukit_console {
    server console:80;
}

upstream henukit_console_gateway {
    server console-gateway:8082;
}

upstream henukit_quiz_web {
    server quizcraft-web:80;
}

upstream henukit_quiz_api {
    server quizcraft-api:10086;
}

upstream henukit_study_api {
    server study-api:8080;
}

map $http_upgrade $connection_upgrade {
    default upgrade;
    ""      close;
}

server {
    listen 80;
    server_name _;
    client_max_body_size 25m;
    server_tokens off;

    # --- Portal public API (BFF) ---
    location /api/ {
        proxy_pass http://henukit_portal_gateway;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_connect_timeout 10s;
        proxy_send_timeout 120s;
        proxy_read_timeout 120s;
    }

    # Optional direct Console Gateway path for same-origin experiments.
    location /console-api/ {
        proxy_pass http://henukit_console_gateway/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # --- Console SPA ---
    location /console/ {
        proxy_pass http://henukit_console;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # --- QuizCraft ---
    location /quiz-api/ {
        # Strip /quiz-api prefix so FastAPI sees /api/... and /ws/...
        rewrite ^/quiz-api/(.*)$ /$1 break;
        proxy_pass http://henukit_quiz_api;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_connect_timeout 10s;
        proxy_send_timeout 120s;
        proxy_read_timeout 120s;
    }

    location /quiz/ {
        proxy_pass http://henukit_quiz_web;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # --- Study API (library backend / internal debug) ---
    location /study-api/ {
        rewrite ^/study-api/(.*)$ /$1 break;
        proxy_pass http://henukit_study_api;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # --- Portal public web ---
    location / {
        proxy_pass http://henukit_portal;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
    }
}
