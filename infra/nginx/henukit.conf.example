# HENU Kit full-stack edge (docker-compose.henukit.yml)
# Variable upstreams + Docker DNS so optional services can restart without blocking boot.

resolver 127.0.0.11 valid=10s ipv6=off;
server_tokens off;

# docker-compose binds this edge to host loopback only. The host TLS
# terminator is therefore the trusted upstream that may supply this header;
# direct local HTTP requests omit it and fall back to $scheme.
map $http_x_forwarded_proto $henukit_forwarded_proto {
  default $http_x_forwarded_proto;
  "" $scheme;
}

server {
  listen 80;
  server_name _;
  client_max_body_size 32m;

  # Portal public site
  location / {
    set $portal_upstream portal:3001;
    proxy_pass http://$portal_upstream;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $henukit_forwarded_proto;
  }

  # Platform Core OAuth (must win over /api/ → portal-gateway).
  # After email-code login, Platform Core redirects to /api/v1/oauth/authorize…
  # which must hit platform-core, not the portal BFF.
  location ^~ /api/v1/oauth/ {
    set $platform_core_upstream platform-core:8081;
    proxy_pass http://$platform_core_upstream;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $henukit_forwarded_proto;
  }

  # EasyPay callback enters the Account Portfolio owner through one exact,
  # unauthenticated Provider route. No user-owned /api/v1/account/* route is
  # exposed directly; those continue through the signed Portal Gateway.
  location = /api/v1/payment-providers/easypay/notifications {
    set $account_portfolio_upstream account-portfolio:8097;
    proxy_pass http://$account_portfolio_upstream;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $henukit_forwarded_proto;
  }

  # Course materials mirrored from the public HENU-Final-Review repository.
  #
  # The mirror root holds only reviewed subject directories. The git checkout,
  # repository tooling and the 待复核 directories are deliberately kept outside
  # it, so a mistake here cannot expose repository internals or unreviewed
  # material. Serving is read-only and nothing under this root is ever executed.
  #
  # A dotfile must never be reachable even if one is mirrored by accident; this
  # regex location outranks the prefix location below.
  location ~ ^/materials/(?:[^/]+/)*\. {
    return 404;
  }

  location ~ "^/materials/releases/(?<materials_release>[a-f0-9]{40}-[a-f0-9]{16})/(?<materials_asset>.+)$" {
    default_type text/plain;
    charset utf-8;
    if (-f /srv/materials/.maintenance) {
      add_header Cache-Control "no-store" always;
      return 503 "资料库正在更新，请稍后重试。";
    }
    error_page 418 = @materials_missing;
    if (!-f /srv/materials/releases/$materials_release/public/$materials_asset) { return 418; }
    alias /srv/materials/releases/$materials_release/public/$materials_asset;
    # No directory listing: the catalogue is the Library, not the file tree.
    autoindex off;
    # Materials only change when the sync replaces a whole file, and Cloudflare
    # caches these extensions by default. A long TTL keeps the origin's narrow
    # uplink out of the read path for repeat downloads.
    add_header Cache-Control "public, max-age=86400, immutable" always;
    # These are third-party documents: never sniff them, never let one render
    # as markup in our origin, and always hand them over as a download.
    add_header X-Content-Type-Options "nosniff" always;
    add_header Content-Disposition "attachment" always;
    add_header Content-Security-Policy "default-src 'none'; sandbox" always;
  }

  location @materials_missing {
    internal;
    types { }
    default_type text/plain;
    charset utf-8;
    add_header Cache-Control "no-store" always;
    return 404 "这份资料暂时无法下载，请返回资料库刷新后重试。";
  }

  # Mutable pointers and legacy unversioned paths are activation internals, not
  # public URLs. The catalogue issues only release-prefixed storage keys.
  location /materials/ {
    types { }
    default_type text/plain;
    charset utf-8;
    add_header Cache-Control "no-store" always;
    return 404 "这个资料链接已失效，请返回资料库重新打开。";
  }

  # Keep the public Library catalogue on the same release boundary as its
  # files. Activation creates this fence before switching either side.
  location ~ ^/api/v1/library(?:/|$) {
    default_type application/json;
    charset utf-8;
    charset_types application/json;
    if (-f /srv/materials/.maintenance) {
      add_header Cache-Control "no-store" always;
      add_header X-Content-Type-Options "nosniff" always;
      return 503 '{"error":{"code":"LIBRARY_MAINTENANCE","message":"资料库正在更新，请稍后重试。"},"request_id":"$request_id"}';
    }
    set $portal_gateway_upstream portal-gateway:8084;
    proxy_pass http://$portal_gateway_upstream;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $henukit_forwarded_proto;
  }

  # Portal gateway BFF (/api/v1/*)
  location /api/ {
    set $portal_gateway_upstream portal-gateway:8084;
    proxy_pass http://$portal_gateway_upstream;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $henukit_forwarded_proto;
  }

  # Legacy /console/ path. The Console image is now built with VITE_BASE_PATH=/
  # and serves only its console.henukit.cn subdomain, so proxying here 404s.
  # Redirect to the subdomain instead. 302 (not 308) while the cutover
  # observation window is open: browsers do not cache a 302, so the documented
  # rollback stays clean. Flip to 308 or drop this location once the window
  # closes (see docs/operations/henukit-domain-cutover.md).
  location /console/ {
    return 302 https://console.henukit.cn/;
  }

  # Console gateway (ops API) — legacy shared-edge path, kept only for the
  # OAuth observation window (henukit.cn/console-api/* callbacks are still
  # registered in oauth_clients). Remove with the /console/ redirect once the
  # window closes.
  location /console-api/ {
    set $console_gateway_upstream console-gateway:8082;
    rewrite ^/console-api/(.*)$ /api/$1 break;
    proxy_pass http://$console_gateway_upstream;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $henukit_forwarded_proto;
  }

  # Platform Core account center (browser login UI)
  location /account-auth/ {
    set $platform_core_upstream platform-core:8081;
    rewrite ^/account-auth/(.*)$ /$1 break;
    proxy_pass http://$platform_core_upstream;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $henukit_forwarded_proto;
  }

}

# Console subdomain: same-origin /api/* must reach the Console Gateway, not
# the Portal Gateway. This vhost serves the Console UI at / and forwards /api/
# to the console-gateway service directly.
server {
  listen 80;
  server_name console.henukit.cn;
  client_max_body_size 32m;

  # Console UI
  location / {
    set $console_upstream console:80;
    proxy_pass http://$console_upstream;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $henukit_forwarded_proto;
  }

  # Console Gateway same-origin API
  location ~ ^/api/v1/library(?:/|$) {
    default_type application/json;
    charset utf-8;
    charset_types application/json;
    if (-f /srv/materials/.maintenance) {
      add_header Cache-Control "no-store" always;
      add_header X-Content-Type-Options "nosniff" always;
      return 503 '{"error":{"code":"LIBRARY_MAINTENANCE","message":"资料库正在更新，请稍后重试。"},"request_id":"$request_id"}';
    }
    set $console_gateway_upstream console-gateway:8082;
    proxy_pass http://$console_gateway_upstream;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $henukit_forwarded_proto;
  }

  location /api/ {
    set $console_gateway_upstream console-gateway:8082;
    proxy_pass http://$console_gateway_upstream;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $henukit_forwarded_proto;
  }
}
