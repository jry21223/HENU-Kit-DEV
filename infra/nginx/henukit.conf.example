# HENU Kit full-stack edge (docker-compose.henukit.yml)
# Variable upstreams + Docker DNS so optional services can restart without blocking boot.

resolver 127.0.0.11 valid=10s ipv6=off;

server {
  listen 80;
  server_name _;
  client_max_body_size 32m;

  # Portal public site
  location / {
    set $portal_upstream portal:3001;
    proxy_pass http://$portal_upstream;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }

  # Portal gateway BFF (/api/v1/*)
  location /api/ {
    set $portal_gateway_upstream portal-gateway:8084;
    proxy_pass http://$portal_gateway_upstream;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }

  # Sole admin console UI
  location /console/ {
    set $console_upstream console:80;
    proxy_pass http://$console_upstream;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }

  # Console gateway (ops API) — optional; fails soft if down
  location /console-api/ {
    set $console_gateway_upstream console-gateway:8082;
    rewrite ^/console-api/(.*)$ /api/$1 break;
    proxy_pass http://$console_gateway_upstream;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }

  # QuizCraft product
  location /quiz/ {
    set $quiz_web_upstream quizcraft-web:80;
    proxy_pass http://$quiz_web_upstream;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }

  location /quiz-api/ {
    set $quiz_api_upstream quizcraft-api:10086;
    rewrite ^/quiz-api/(.*)$ /$1 break;
    proxy_pass http://$quiz_api_upstream;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";
  }

  # Study materials API (backend/debug)
  location /study-api/ {
    set $study_api_upstream study-api:8080;
    rewrite ^/study-api/(.*)$ /$1 break;
    proxy_pass http://$study_api_upstream;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }

  # Platform Core account center (browser login UI)
  location /account-auth/ {
    set $platform_core_upstream platform-core:8081;
    rewrite ^/account-auth/(.*)$ /$1 break;
    proxy_pass http://$platform_core_upstream;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }

}
