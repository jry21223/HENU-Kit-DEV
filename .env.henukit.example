# HENU Kit full-stack compose example.
# Copy to .env.henukit and adjust. DO NOT put real production secrets here.

COMPOSE_PROJECT_NAME=henukit

# ---------- Postgres (single instance, multiple DBs) ----------
POSTGRES_USER=henukit
POSTGRES_PASSWORD=henukit_dev_change_me
POSTGRES_DB=postgres
# Connection helpers used by services
STUDY_DATABASE_URL=postgres://henukit:henukit_dev_change_me@postgres:5432/study?sslmode=disable
PLATFORM_CORE_DATABASE_URL=postgres://henukit:henukit_dev_change_me@postgres:5432/platform?sslmode=disable
QUIZCRAFT_DATABASE_URL=postgres://henukit:henukit_dev_change_me@postgres:5432/quizcraft?sslmode=disable
PORTAL_DATABASE_URL=postgres://henukit:henukit_dev_change_me@postgres:5432/portal?sslmode=disable
NOTICE_DATABASE_URL=postgres://henukit:henukit_dev_change_me@postgres:5432/notice?sslmode=disable
LIBRARY_DATABASE_URL=postgres://henukit:henukit_dev_change_me@postgres:5432/library?sslmode=disable
FOOD_DATABASE_URL=postgres://henukit:henukit_dev_change_me@postgres:5432/food?sslmode=disable
ACCOUNT_PORTFOLIO_DATABASE_URL=postgres://henukit:henukit_dev_change_me@postgres:5432/account_portfolio?sslmode=disable

# ---------- Redis ----------
REDIS_ADDR=redis:6379
REDIS_URL=redis://redis:6379/0
PLATFORM_CORE_REDIS_URL=redis://redis:6379/0
PORTAL_GATEWAY_REDIS_URL=redis://redis:6379/2
NOTICE_REDIS_URL=redis://redis:6379/3
FOOD_REDIS_URL=redis://redis:6379/4

# ---------- Public origins (local compose edge on :8088) ----------
PUBLIC_ORIGIN=http://localhost:8088
PORTAL_ORIGIN=http://localhost:8088
CONSOLE_ORIGIN=http://localhost:8088/console
QUIZ_ORIGIN=http://localhost:8088/quiz

# ---------- Platform Core (identity) ----------
PLATFORM_CORE_ADDRESS=:8081
# base64 of exactly 32 raw bytes (openssl rand -base64 32)
PLATFORM_CORE_IDEMPOTENCY_KEY=cUUpjiEH+E5FD5YBx3ZKWN7qS7tyWHo24/HCXs+OIGI=
PLATFORM_CORE_VERIFICATION_KEY=cUUpjiEH+E5FD5YBx3ZKWN7qS7tyWHo24/HCXs+OIGI=
PLATFORM_CORE_MAIL_DELIVERY_TOKEN=Wld9pvxGjnWc_54pv7SliNmbZELBYpFHsX1vaqpK4co
PLATFORM_CORE_MAIL_DELIVERY_KEY_ID=mail-provider-active
PLATFORM_CORE_STUDENT_EMAIL_DOMAINS=henu.edu.cn
PLATFORM_CORE_PUBLIC_PATH_PREFIX=/account-auth
PLATFORM_CORE_TRUSTED_PROXY_CIDRS=172.16.0.0/12
PLATFORM_CORE_LOCAL_COOKIE_NAME=henukit_core_session_local
PLATFORM_CORE_CORE_SESSION_TTL=360h
PLATFORM_CORE_AUTHORIZATION_TTL=90s
PLATFORM_CORE_EXCHANGE_SESSION_TTL=8h
PLATFORM_CORE_IDEMPOTENCY_TTL=24h
PLATFORM_CORE_VERIFICATION_CODE_TTL=10m
PLATFORM_CORE_VERIFICATION_RESEND_DELAY=60s
PLATFORM_CORE_PASSWORD_MEMORY_KIB=65536
PLATFORM_CORE_PASSWORD_ITERATIONS=3
PLATFORM_CORE_PASSWORD_PARALLELISM=1
PLATFORM_CORE_PASSWORD_HASH_CONCURRENCY=2

# ---------- Portal Gateway (public BFF) ----------
PORTAL_GATEWAY_LISTEN_ADDR=:8084
# Raw 32-byte string (not base64). Error message in gateway is historical.
PORTAL_SESSION_KEY=henukit-portal-session-key-32byt
PLATFORM_CORE_URL=http://platform-core:8081
# Browser-facing Account Center base URL. It may differ from the private Core URL.
PLATFORM_CORE_PUBLIC_URL=http://localhost:8088/account-auth
PLATFORM_CLIENT_ID=portal-gateway
PLATFORM_CLIENT_SECRET=replace-portal-gateway-client-secret
PLATFORM_KEY_ID=portal-gateway-key
PORTAL_REDIRECT_URI=http://localhost:8088/api/v1/auth/callback
PORTAL_API_URL=http://portal-api:8085
# Product service stubs / future owners (point at portal-api mock for local)
LIBRARY_SERVICE_URL=http://portal-api:8085
FOOD_SERVICE_URL=http://portal-api:8085
PRACTICE_SERVICE_URL=http://portal-api:8085
# Keep 0 before #166. A real QuizCraft V2 Core URL and credentials are also
# required before coordinated local/cutover testing can set this to 1.
PORTAL_ENABLE_QUIZCRAFT_CATALOG=0
# Linux production resolves this stable name through Compose's host-gateway
# mapping; QuizCraft Core listens only on the private HENU bridge gateway.
QUIZCRAFT_CORE_URL=http://host.docker.internal:10089
QUIZCRAFT_PORTAL_CATALOG_CLIENT_ID=portal-gateway-quizcraft-read
QUIZCRAFT_PORTAL_CATALOG_CLIENT_SECRET=replace-quizcraft-portal-read-secret-32bytes-min!!
QUIZCRAFT_PORTAL_CATALOG_KEY_ID=quizcraft-portal-read-key
# #166 enables both sides only after the fixed-SHA read and recovery gates pass.
PORTAL_ENABLE_QUIZCRAFT_V2_READS=0
PORTAL_PRACTICE_COMMANDS_ENABLED=0
PRACTICE_COMMAND_CLIENT_ID=portal-gateway-quizcraft-command
PRACTICE_COMMAND_CLIENT_SECRET=replace-quizcraft-portal-command-secret-32bytes-min!!
PRACTICE_COMMAND_KEY_ID=quizcraft-portal-command-key
NOTICE_SERVICE_URL=http://portal-api:8085
PRACTICE_CLIENT_ID=portal-practice
PRACTICE_CLIENT_SECRET=replace-practice-secret
PRACTICE_KEY_ID=practice-key
NOTICE_CLIENT_ID=portal-notice
NOTICE_CLIENT_SECRET=replace-notice-secret
NOTICE_KEY_ID=notice-key
# Account Portfolio is a separate durable owner, never a Study data adapter.
ACCOUNT_PORTFOLIO_ADDR=:8097
ACCOUNT_PORTFOLIO_URL=http://account-portfolio:8097
# Console uses the same private owner endpoint through a separately credentialed caller.
ACCOUNT_PORTFOLIO_API_URL=http://account-portfolio:8097
ACCOUNT_PORTFOLIO_CLIENT_ID=portal-gateway
ACCOUNT_PORTFOLIO_CLIENT_SECRET=replace-account-portfolio-client-secret-32bytes-min!!
ACCOUNT_PORTFOLIO_KEY_ID=account-portfolio-key
# Console is a separate, actor-bound caller. Never reuse the Portal credential.
ACCOUNT_PORTFOLIO_CONSOLE_CLIENT_ID=console-gateway
ACCOUNT_PORTFOLIO_CONSOLE_SECRET=replace-account-portfolio-console-secret-32bytes-min!!
ACCOUNT_PORTFOLIO_CONSOLE_KEY_ID=account-portfolio-console-key
# Base64 of exactly 32 raw bytes. Generate a unique production value with
# `openssl rand -base64 32`; never reuse a Portal/Console credential or log it.
ACCOUNT_PORTFOLIO_POINT_CURSOR_KEY=cmVwbGFjZS14eHh4eHh4eHh4eHh4eHh4eHh4eHh4eHg=
# Payment remains disabled until the separately authorized #173 release window.
# EasyPay owns the WeChat merchant credentials; this service receives only the
# isolated HENU tenant PID/key used for signed gateway requests.
ACCOUNT_PORTFOLIO_EASYPAY_ENABLED=0
ACCOUNT_PORTFOLIO_EASYPAY_BASE_URL=https://metaview.top/epay
ACCOUNT_PORTFOLIO_EASYPAY_PID=replace-henukit-easypay-pid
ACCOUNT_PORTFOLIO_EASYPAY_KEY=replace-henukit-easypay-tenant-key
ACCOUNT_PORTFOLIO_EASYPAY_NOTIFY_URL=https://henukit.cn/api/v1/payment-providers/easypay/notifications
ACCOUNT_PORTFOLIO_EASYPAY_RETURN_URL=https://henukit.cn/account/membership

# ---------- Portal API ----------
PORTAL_API_LISTEN_ADDR=:8085
PORTAL_API_MODE=live
# Defense-in-depth release gate: production must never opt into browser mocks.
NEXT_PUBLIC_PORTAL_ALLOW_MOCK=0

# ---------- Console Gateway (ops) ----------
CONSOLE_GATEWAY_LISTEN_ADDR=:8082
CONSOLE_SESSION_KEY=cUUpjiEH+E5FD5YBx3ZKWN7qS7tyWHo24/HCXs+OIGI=
# Browser-facing Account Center URL for Console OAuth redirects; never use platform-core:8081.
PLATFORM_ACCOUNT_ORIGIN=http://localhost:8088/account-auth
CONSOLE_REDIRECT_URI=http://localhost:8088/console-api/v1/auth/callback
CONSOLE_PLATFORM_CLIENT_ID=console-gateway
CONSOLE_PLATFORM_CLIENT_SECRET=replace-console-gateway-client-secret
CONSOLE_PLATFORM_KEY_ID=console-gateway-key
# Summary URLs may be empty/unreachable in local mock; gateway degrades per module.
PORTAL_SUMMARY_URL=
PORTAL_SUMMARY_CLIENT_ID=console-gateway-portal
PORTAL_SUMMARY_CLIENT_SECRET=replace-portal-summary-secret
PORTAL_SUMMARY_KEY_ID=portal-summary-key
PLATFORM_SUMMARY_URL=http://platform-core:8081/api/v1/console-summary
PLATFORM_SUMMARY_CLIENT_ID=console-gateway-platform
PLATFORM_SUMMARY_CLIENT_SECRET=replace-platform-summary-secret
PLATFORM_SUMMARY_KEY_ID=platform-summary-key
NOTICE_SUMMARY_URL=http://notice:8094/api/v1/console-summary
NOTICE_API_URL=http://notice:8094
# study-api was the library data owner before the standalone Study runtime
# was retired (see docs/operations/henukit-artifact-deployment.md); no
# replacement backend exists yet, so LIBRARY_API_URL stays empty and the
# gateway degrades that module to 503 instead of resolving a host that no
# longer runs. Notice and Food are first-class compose owners (see
# docs/operations/notice-food-production-onboarding.md).
LIBRARY_API_URL=
FOOD_API_URL=http://food:8096
NOTICE_SUMMARY_CLIENT_ID=console-gateway-notice
NOTICE_SUMMARY_CLIENT_SECRET=replace-notice-summary-secret
NOTICE_SUMMARY_KEY_ID=notice-summary-key
# Notice delivery webhook; empty keeps distributions queued until a provider
# is provisioned (worker retries without failing the release).
NOTICE_DELIVERY_URL=
NOTICE_DELIVERY_TOKEN=
LIBRARY_SUMMARY_URL=
LIBRARY_SUMMARY_CLIENT_ID=console-gateway-library
LIBRARY_SUMMARY_CLIENT_SECRET=replace-library-summary-secret
LIBRARY_SUMMARY_KEY_ID=library-summary-key
QUIZCRAFT_SUMMARY_URL=
QUIZCRAFT_SUMMARY_CLIENT_ID=console-gateway-quizcraft
QUIZCRAFT_SUMMARY_CLIENT_SECRET=replace-quizcraft-summary-secret
QUIZCRAFT_SUMMARY_KEY_ID=quizcraft-summary-key
FOOD_SUMMARY_URL=http://food:8096/api/v1/console-summary
FOOD_SUMMARY_CLIENT_ID=console-gateway-food
FOOD_SUMMARY_CLIENT_SECRET=replace-food-summary-secret
FOOD_SUMMARY_KEY_ID=food-summary-key

# ---------- Study API (library data owner) ----------
STUDY_API_PORT=8080
STUDY_CORS_ALLOWED_ORIGINS=http://localhost:8088,http://localhost:3001
AUTO_MIGRATE=true
LLM_MODE=mock
WORKER_HEALTH_PORT=9090

# ---------- QuizCraft ----------
QUIZCRAFT_APP_HOST=0.0.0.0
QUIZCRAFT_APP_PORT=10086
QUIZCRAFT_READ_ONLY=0
# Server-side only. Never expose as VITE_*.
QUIZCRAFT_ADMIN_TOKEN=dev-only-quizcraft-admin-token
QUIZCRAFT_CORS_ORIGINS=http://localhost:8088
VITE_API_BASE_URL=/quiz-api/api
VITE_BASE_PATH=/quiz/
VITE_APP_MODE=full

# ---------- Frontends build args ----------
VITE_CONSOLE_BASE_PATH=/console/
VITE_QUIZCRAFT_WORKSHOP_URL=/quiz/extract
NEXT_PUBLIC_PORTAL_GATEWAY_URL=
NEXT_PUBLIC_PORTAL_GATEWAY_BASE_URL=/api
# 0 keeps mock-friendly portal boot; set 1 when gateway is required
NEXT_PUBLIC_PORTAL_REQUIRE_GATEWAY=0
# Keep 0 before #166. The Portal build only renders the real V2 catalog when
# this and PORTAL_ENABLE_QUIZCRAFT_CATALOG are both explicitly set to 1.
NEXT_PUBLIC_PORTAL_ENABLE_QUIZCRAFT_CATALOG=0

# ---------- Mail (Aliyun DirectMail SMTP) ----------
# Complete Aliyun console + DNS first (docs/operations/aliyun-directmail-setup.md)
# then fill USERNAME / PASSWORD / FROM. Until then worker will run but SMTP sends fail.
PLATFORM_CORE_MAIL_PROVIDER_TOKEN=replace-mail-provider-token-32chars-min!!
PLATFORM_CORE_MAIL_PROVIDER_KEY_ID=mail-provider-active
PLATFORM_CORE_MAIL_PROVIDER_ENDPOINT=http://platform-smtp-provider:18081/internal/send
PLATFORM_CORE_MAIL_WORKER_ID=platform-mail-worker-1
PLATFORM_CORE_SMTP_ALLOW_DOCKER=1
PLATFORM_CORE_SMTP_PROVIDER_ADDRESS=0.0.0.0:18081
PLATFORM_CORE_SMTP_PROVIDER_ID=aliyun-directmail
PLATFORM_CORE_SMTP_ADDRESS=smtpdm.aliyun.com:465
PLATFORM_CORE_SMTP_USERNAME=
PLATFORM_CORE_SMTP_PASSWORD=
# Must be an address under the verified DirectMail sender domain.
PLATFORM_CORE_SMTP_FROM=noreply@notify.henukit.cn
PLATFORM_CORE_SMTP_MESSAGE_ID_DOMAIN=notify.henukit.cn
