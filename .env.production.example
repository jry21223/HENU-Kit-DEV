COMPOSE_PROJECT_NAME=final-review-platform-prod

# Public domains used by nginx and browser-facing API clients.
PUBLIC_WEB_ORIGIN=https://review.example.com
PUBLIC_ADMIN_ORIGIN=https://admin.review.example.com
PUBLIC_API_BASE_URL=https://review.example.com/api/v1

# PostgreSQL / Redis. Replace every change-me value before deployment.
POSTGRES_DB=final_review_v2
POSTGRES_USER=final_review
POSTGRES_PASSWORD=change-me-postgres-password
DATABASE_URL=postgres://final_review:change-me-postgres-password@postgres:5432/final_review_v2?sslmode=disable
REDIS_PASSWORD=change-me-redis-password
REDIS_ADDR=redis:6379
REDIS_DB=0

# API
APP_ENV=production
API_PORT=8080
APP_VERSION=0.1.0
AUTO_MIGRATE=false
CORS_ALLOWED_ORIGINS=https://review.example.com,https://admin.review.example.com
RATE_LIMIT_RPS=20
RATE_LIMIT_BURST=40
OPERATION_LOG_RETENTION_DAYS=180
OPERATION_LOG_EXPORT_LIMIT=5000

# JWT keys should be mounted from ./secrets/jwt/.
JWT_ISSUER=final-review-platform
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_HOURS=168
JWT_PRIVATE_KEY_PATH=/run/secrets/final-review/jwt_private.pem
JWT_PUBLIC_KEY_PATH=/run/secrets/final-review/jwt_public.pem
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=

# Production must not set DEV_FIXED_VERIFICATION_CODE.
DEV_FIXED_VERIFICATION_CODE=

# Frontend build/runtime config.
NEXT_PUBLIC_API_BASE_URL=https://review.example.com/api/v1
VITE_API_BASE_URL=https://admin.review.example.com/api/v1

# Local storage volume mounted into API.
STORAGE_DRIVER=local
LOCAL_UPLOAD_DIR=/app/uploads

# WeChat Pay Native live mode. Mount private key/certs from ./secrets/wechat and ./certs/wechat.
WECHAT_PAY_MODE=live
WECHAT_PAY_API_BASE_URL=https://api.mch.weixin.qq.com
WECHAT_PAY_APPID=
WECHAT_PAY_MCH_ID=
WECHAT_PAY_API_V3_KEY=
WECHAT_PAY_MERCHANT_SERIAL_NO=
WECHAT_PAY_MERCHANT_PRIVATE_KEY=
WECHAT_PAY_MERCHANT_PRIVATE_KEY_PATH=/run/secrets/final-review/wechat/apiclient_key.pem
WECHAT_PAY_PLATFORM_CERTS_DIR=/run/certs/final-review/wechat
WECHAT_PAY_NOTIFY_URL=https://review.example.com/api/v1/payments/wechat/notify
WECHAT_PAY_NATIVE_EXPIRE_MINUTES=15

# Operator alert webhook for payment incidents.
PAYMENT_INCIDENT_WEBHOOK_URL=
PAYMENT_INCIDENT_WEBHOOK_SECRET=
PAYMENT_INCIDENT_WEBHOOK_TIMEOUT_SECONDS=3

# LLM. Keep mock until real provider credentials are configured and tested.
LLM_MODE=mock
AI_TASK_STREAM=ai_tasks
WORKER_HEALTH_PORT=9090
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
