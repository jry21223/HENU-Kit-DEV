# Portal API configuration
LISTEN_ADDR=:8085

# Operating mode: live | mock
# - live: production fail-closed; empty DSN / ping failure aborts startup; never returns mock as success
# - mock: local fixtures allowed when DSN is empty
# Default: live when APP_ENV=production|prod, otherwise mock
APP_ENV=development
PORTAL_API_MODE=mock

# Browser origin for CORS (required in live; must NOT be *)
# Credentials are enabled only with an explicit origin.
PORTAL_ORIGIN=http://127.0.0.1:3001

# --- Live requirements (all required when PORTAL_API_MODE=live) ---

# QuizCraft database (PostgreSQL — practice banks, questions, rankings)
QUIZCRAFT_DATABASE_URL=postgres://quizcraft:quizcraft@localhost:5432/quizcraft

# Study API database (PostgreSQL — library courses and materials)
STUDY_DATABASE_URL=postgres://final_review:final_review_dev@localhost:5432/final_review_v2

# Portal content database (MySQL — food posts, campus items)
# Format: mysql://user:password@tcp(host:port)/dbname
PORTAL_DATABASE_URL=mysql://portal:portal@tcp(127.0.0.1:3306)/portal
