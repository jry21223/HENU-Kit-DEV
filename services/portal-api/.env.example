# Portal API configuration
LISTEN_ADDR=:8085
PORTAL_ORIGIN=http://127.0.0.1:3001

# Database connections (leave empty for mock mode)

# QuizCraft database (PostgreSQL — for practice questions, banks, rankings)
QUIZCRAFT_DATABASE_URL=postgres://quizcraft:quizcraft@localhost:5432/quizcraft

# Study API database (PostgreSQL — for library courses and materials)
STUDY_DATABASE_URL=postgres://final_review:final_review_dev@localhost:5432/final_review_v2

# Portal database (MySQL — for food posts, campus items)
# Format: mysql://user:password@tcp(host:port)/dbname
PORTAL_DATABASE_URL=mysql://portal:portal@tcp(127.0.0.1:3306)/portal
