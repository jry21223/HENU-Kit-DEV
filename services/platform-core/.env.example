PLATFORM_CORE_ADDRESS=:8081
PLATFORM_CORE_DATABASE_URL=postgres://platform_core:change-me@postgres:5432/platform_core?sslmode=require
PLATFORM_CORE_REDIS_URL=rediss://:change-me@redis:6379/0
PLATFORM_CORE_COOKIE_NAME=__Host-henukit_core_session
PLATFORM_CORE_AUTHORIZATION_TTL=90s
PLATFORM_CORE_EXCHANGE_SESSION_TTL=5m
# Generate with: openssl rand -base64 32
PLATFORM_CORE_IDEMPOTENCY_KEY=replace-with-base64-encoded-32-byte-key
PLATFORM_CORE_IDEMPOTENCY_TTL=24h
# Use a different 32-byte key from PLATFORM_CORE_IDEMPOTENCY_KEY.
PLATFORM_CORE_VERIFICATION_KEY=replace-with-base64-encoded-32-byte-key
PLATFORM_CORE_STUDENT_EMAIL_DOMAINS=henu.edu.cn
PLATFORM_CORE_VERIFICATION_CODE_TTL=10m
PLATFORM_CORE_VERIFICATION_RESEND_DELAY=60s
# Mail worker only; endpoint must accept the documented verification template request over HTTPS.
PLATFORM_CORE_MAIL_PROVIDER_ENDPOINT=https://mail-provider.example/internal/send
PLATFORM_CORE_MAIL_PROVIDER_TOKEN=replace-with-secret-manager-reference
PLATFORM_CORE_MAIL_WORKER_ID=platform-mail-worker-1
