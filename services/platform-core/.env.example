PLATFORM_CORE_ADDRESS=:8081
PLATFORM_CORE_DATABASE_URL=postgres://platform_core:change-me@postgres:5432/platform_core?sslmode=require
PLATFORM_CORE_REDIS_URL=rediss://:change-me@redis:6379/0
# Optional comma-separated CIDRs allowed to supply the first X-Forwarded-For address.
PLATFORM_CORE_TRUSTED_PROXY_CIDRS=
PLATFORM_CORE_COOKIE_NAME=__Host-henukit_core_session
# Used only for direct local HTTP. It must not use the __Host- prefix.
PLATFORM_CORE_LOCAL_COOKIE_NAME=henukit_core_session_local
# Absolute lifetime. Core Sessions are not extended by activity.
PLATFORM_CORE_CORE_SESSION_TTL=360h
PLATFORM_CORE_AUTHORIZATION_TTL=90s
PLATFORM_CORE_EXCHANGE_SESSION_TTL=8h
# Generate with: openssl rand -base64 32
PLATFORM_CORE_IDEMPOTENCY_KEY=replace-with-base64-encoded-32-byte-key
PLATFORM_CORE_IDEMPOTENCY_TTL=24h
# Use a different 32-byte key from PLATFORM_CORE_IDEMPOTENCY_KEY.
PLATFORM_CORE_VERIFICATION_KEY=replace-with-base64-encoded-32-byte-key
PLATFORM_CORE_STUDENT_EMAIL_DOMAINS=henu.edu.cn
PLATFORM_CORE_VERIFICATION_CODE_TTL=10m
PLATFORM_CORE_VERIFICATION_RESEND_DELAY=60s
# Versioned Argon2id PHC verifier parameters. Benchmark on the production host
# before changing these values; keep observed hashes within the documented target.
PLATFORM_CORE_PASSWORD_MEMORY_KIB=65536
PLATFORM_CORE_PASSWORD_ITERATIONS=3
PLATFORM_CORE_PASSWORD_PARALLELISM=1
# Bounds concurrent Argon2id work so login pressure cannot exhaust host memory.
PLATFORM_CORE_PASSWORD_HASH_CONCURRENCY=2
# Mail worker only; endpoint must accept the documented verification template request over HTTPS.
PLATFORM_CORE_MAIL_PROVIDER_ENDPOINT=http://127.0.0.1:18081/internal/send
PLATFORM_CORE_MAIL_PROVIDER_TOKEN=replace-with-secret-manager-reference
PLATFORM_CORE_MAIL_PROVIDER_KEY_ID=mail-provider-active
PLATFORM_CORE_MAIL_WORKER_ID=platform-mail-worker-1
# Local loopback provider. Keep the mailbox/app password only in the root-owned
# provider environment file; never place it in Git, issues, or chat.
PLATFORM_CORE_SMTP_PROVIDER_ADDRESS=127.0.0.1:18081
PLATFORM_CORE_SMTP_PROVIDER_ID=local-smtp
PLATFORM_CORE_SMTP_LEDGER_DIR=/var/lib/henukit-smtp-provider
PLATFORM_CORE_SMTP_ADDRESS=smtp.example.com:587
PLATFORM_CORE_SMTP_USERNAME=sender@example.com
PLATFORM_CORE_SMTP_PASSWORD=replace-with-root-owned-app-password
PLATFORM_CORE_SMTP_FROM=sender@example.com
# Shared only with the mail provider delivery-receipt webhook; use at least 32 random characters.
PLATFORM_CORE_MAIL_DELIVERY_TOKEN=replace-with-random-delivery-webhook-token
PLATFORM_CORE_MAIL_DELIVERY_KEY_ID=mail-provider-active
# Optional retiring key accepted only during a controlled rotation window.
PLATFORM_CORE_MAIL_DELIVERY_RETIRING_KEY_ID=
PLATFORM_CORE_MAIL_DELIVERY_RETIRING_TOKEN=
