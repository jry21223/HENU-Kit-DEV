FROM golang:1.26-alpine AS build
WORKDIR /src
COPY . .
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/platform-smtp-provider ./cmd/smtp-provider

FROM alpine:3.23
RUN apk add --no-cache ca-certificates && addgroup -S platform && adduser -S -G platform platform
COPY --from=build /out/platform-smtp-provider /usr/local/bin/platform-smtp-provider
USER platform
ENTRYPOINT ["platform-smtp-provider"]
