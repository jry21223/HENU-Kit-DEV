# Portal Gateway configuration
LISTEN_ADDR=:8084

# Platform Core
PLATFORM_CORE_URL=http://127.0.0.1:8081
PLATFORM_CLIENT_ID=portal-gateway
PLATFORM_CLIENT_SECRET=change-me
PLATFORM_KEY_ID=portal-gateway-key-1

# Portal OAuth
PORTAL_REDIRECT_URI=http://127.0.0.1:8084/api/v1/auth/callback
PORTAL_SESSION_KEY=change-me-base64-32-bytes

# Redis
REDIS_URL=redis://127.0.0.1:6379/2

# Product services (internal URLs)
LIBRARY_SERVICE_URL=http://127.0.0.1:8090
FOOD_SERVICE_URL=http://127.0.0.1:8091
PRACTICE_SERVICE_URL=http://127.0.0.1:8092
NOTICE_SERVICE_URL=http://127.0.0.1:8093

# Service-to-service signing (per product)
LIBRARY_CLIENT_ID=portal-gateway
LIBRARY_CLIENT_SECRET=change-me
LIBRARY_KEY_ID=portal-library-key-1

FOOD_CLIENT_ID=portal-gateway
FOOD_CLIENT_SECRET=change-me
FOOD_KEY_ID=portal-food-key-1

PRACTICE_CLIENT_ID=portal-gateway
PRACTICE_CLIENT_SECRET=change-me
PRACTICE_KEY_ID=portal-practice-key-1

NOTICE_CLIENT_ID=portal-gateway
NOTICE_CLIENT_SECRET=change-me
NOTICE_KEY_ID=portal-notice-key-1

# Frontend
PORTAL_ORIGIN=http://127.0.0.1:3001
