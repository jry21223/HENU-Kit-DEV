# Portal Gateway configuration
LISTEN_ADDR=:8084

# Platform Core
PLATFORM_CORE_URL=http://127.0.0.1:8081
PLATFORM_CLIENT_ID=portal-gateway
PLATFORM_CLIENT_SECRET=change-me
PLATFORM_KEY_ID=portal-gateway-key-1

# Portal OAuth
PORTAL_REDIRECT_URI=http://127.0.0.1:8084/api/v1/auth/callback
PORTAL_SESSION_KEY=change-me-base64-32-bytes
PORTAL_LOCAL_OAUTH_COOKIE_NAME=henukit_portal_oauth_local
PORTAL_LOCAL_SESSION_COOKIE_NAME=henukit_portal_session_local
PORTAL_TRUSTED_PROXY_CIDRS=127.0.0.0/8

# Redis
REDIS_URL=redis://127.0.0.1:6379/2

# Portal API (user-facing data service)
PORTAL_API_URL=http://127.0.0.1:8085

# Product services (internal URLs — for admin operations, not used by Portal)
LIBRARY_SERVICE_URL=http://127.0.0.1:8090
FOOD_SERVICE_URL=http://127.0.0.1:8091
PRACTICE_SERVICE_URL=http://127.0.0.1:8092
# Dark until the #166 full V2 cutover. The Portal browser flag must also be
# enabled, otherwise no browser-visible QuizCraft catalog exists.
PORTAL_ENABLE_QUIZCRAFT_CATALOG=0
NOTICE_SERVICE_URL=http://127.0.0.1:8093

# Service-to-service signing (per product)
PRACTICE_CLIENT_ID=portal-gateway
PRACTICE_CLIENT_SECRET=change-me
PRACTICE_KEY_ID=portal-practice-key-1

# Narrow QuizCraft command capability. It intentionally uses a separate key
# from the read-only catalog integration and remains dark until #166.
PORTAL_PRACTICE_COMMANDS_ENABLED=0
PRACTICE_COMMAND_CLIENT_ID=portal-gateway-practice-command
PRACTICE_COMMAND_CLIENT_SECRET=change-me-at-least-32-characters-long-and-distinct
PRACTICE_COMMAND_KEY_ID=portal-practice-command-key-1

NOTICE_CLIENT_ID=portal-gateway
NOTICE_CLIENT_SECRET=change-me
NOTICE_KEY_ID=portal-notice-key-1

# Account Portfolio (private persistent account owner)
ACCOUNT_PORTFOLIO_URL=http://127.0.0.1:8097
ACCOUNT_PORTFOLIO_CLIENT_ID=portal-gateway
ACCOUNT_PORTFOLIO_CLIENT_SECRET=change-me-at-least-32-characters-long
ACCOUNT_PORTFOLIO_KEY_ID=account-portfolio-key-1

# QuizCraft V2 personal-stat reads — remain 0 until the #166 cutover window.
# The browser flag is separate and must also remain 0 before that window.
PORTAL_ENABLE_QUIZCRAFT_V2_READS=0
QUIZCRAFT_CORE_URL=
QUIZCRAFT_PORTAL_CATALOG_CLIENT_ID=
QUIZCRAFT_PORTAL_CATALOG_CLIENT_SECRET=
QUIZCRAFT_PORTAL_CATALOG_KEY_ID=

# Frontend
PORTAL_ORIGIN=http://127.0.0.1:3001
