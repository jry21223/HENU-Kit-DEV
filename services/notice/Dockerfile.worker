FROM golang:1.26-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -trimpath -o /notice-worker ./cmd/worker

FROM gcr.io/distroless/static-debian12:nonroot
COPY --from=build /notice-worker /notice-worker
USER nonroot:nonroot
ENTRYPOINT ["/notice-worker"]
