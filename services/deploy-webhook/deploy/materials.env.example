# Materials sync webhook receiver + runner configuration.
# 由 install.sh --enable-materials-sync 生成到 /etc/henukit-deploy/materials-webhook.env。
# 接收器(systemd: henukit-materials-webhook.service)与 runner
# (henukit-materials-runner.service,由 henukit-materials-webhook.path 触发)
# 共用本文件;runner 以 root 运行以访问 docker 与镜像目录。

# ---- receiver (henukit-deploy-webhook serve) ----
HENUKIT_WEBHOOK_LISTEN_ADDR=127.0.0.1:10088
HENUKIT_WEBHOOK_PATH=/webhooks/materials
HENUKIT_WEBHOOK_REPOSITORY=jry21223/HENU-Final-Review
HENUKIT_WEBHOOK_BRANCH=main
HENUKIT_WEBHOOK_STATE_DIR=/var/lib/henukit-materials-webhook

# ---- runner (henukit-deploy-webhook run) ----
HENUKIT_DEPLOY_COMMAND=/usr/local/libexec/henukit/henukit-materials-sync
HENUKIT_DEPLOY_TIMEOUT=2h

# ---- materials sync driver ----
HENUKIT_MATERIALS_ROOT=/opt/henukit-materials
HENUKIT_MATERIALS_REPO_URL=https://github.com/jry21223/HENU-Final-Review.git
HENUKIT_MATERIALS_REPO_REF=main
# 直接数据库连接串(可选;设置后 driver 使用主机 psql 直连,不再走 compose):
# HENUKIT_MATERIALS_DATABASE_URL=postgres://henukit:CHANGE_ME@127.0.0.1:5432/study?sslmode=disable
# release 目录(含 docker-compose.henukit.release.yml);留空则取
# /opt/henukit-releases 下最新目录:
HENUKIT_MATERIALS_RELEASE_DIR=
HENUKIT_MATERIALS_ENV_FILE=/opt/henukit/.env.henukit
