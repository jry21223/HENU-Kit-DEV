# Materials sync webhook receiver configuration. This file is readable by the
# unprivileged HTTP service and must never contain database or runner secrets.
# 由 install.sh --enable-materials-sync 生成到 /etc/henukit-deploy/materials-webhook.env。
# 接收器与非特权 queue runner 共用本文件中的状态目录和队列语义。
# 数据库/发布参数仅由精确 sudo root helper 从 materials-runner.env 读取。

# ---- receiver (henukit-deploy-webhook serve) ----
HENUKIT_WEBHOOK_LISTEN_ADDR=127.0.0.1:10088
HENUKIT_WEBHOOK_PATH=/webhooks/materials
HENUKIT_WEBHOOK_REPOSITORY=jry21223/HENU-Final-Review
HENUKIT_WEBHOOK_BRANCH=main
HENUKIT_WEBHOOK_STATE_DIR=/var/lib/henukit-materials-webhook
HENUKIT_WEBHOOK_MAX_BODY_BYTES=1048576
HENUKIT_WEBHOOK_MAX_QUEUE=1
HENUKIT_WEBHOOK_QUEUE_MODE=latest
HENUKIT_WEBHOOK_PROCESSED_RETENTION=720h
