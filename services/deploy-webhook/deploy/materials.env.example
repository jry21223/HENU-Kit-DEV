# Receiver and unprivileged preparation configuration. Privileged sealing and
# activation authority remains in separate root-only configuration files.

# ---- materials receiver (henukit-deploy-webhook materials-serve) ----
HENUKIT_WEBHOOK_LISTEN_ADDR=127.0.0.1:10088
HENUKIT_WEBHOOK_PATH=/webhooks/materials
HENUKIT_WEBHOOK_REPOSITORY=jry21223/HENU-Final-Review
HENUKIT_WEBHOOK_BRANCH=main
HENUKIT_WEBHOOK_STATE_DIR=/var/lib/henukit-materials-webhook
HENUKIT_WEBHOOK_PROCESSED_RETENTION=720h
HENUKIT_WEBHOOK_MAX_BODY_BYTES=1048576

# ---- unprivileged candidate preparation invoked by the fixed root runner ----
HENUKIT_MATERIALS_SOURCE_REPOSITORY=https://github.com/jry21223/HENU-Final-Review.git
HENUKIT_MATERIALS_CANDIDATE_ROOT=/var/lib/henukit-materials-webhook/candidates
HENUKIT_MATERIALS_PREPARATION_TIMEOUT=2h
