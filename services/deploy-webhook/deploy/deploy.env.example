# Root-owned deployment topology. This file may contain commands, but must not
# contain the GitHub webhook secret or the repository Deploy Key.
HENUKIT_ALLOWED_REPOSITORY=jry21223/HENU-Kit-DEV
HENUKIT_GIT_BRANCH=main
HENUKIT_GIT_REMOTE=origin
HENUKIT_EXPECTED_REMOTE_URL=git@github.com:jry21223/HENU-Kit-DEV.git
HENUKIT_REPO_DIR=/opt/henukit/repository
HENUKIT_RELEASES_DIR=/opt/henukit/releases
HENUKIT_CURRENT_LINK=/opt/henukit/current
HENUKIT_DEPLOY_HOOK_DIR=/etc/henukit-deploy/hooks.d
HENUKIT_DEPLOY_STATE_DIR=/var/lib/henukit-deploy-webhook
HENUKIT_APPROVAL_DIR=/etc/henukit-deploy/approved-shas
HENUKIT_KEEP_RELEASES=5

# high-risk: first release and changes to Migration, auth, contracts, infra,
# deployment automation, Platform Core, or cutover scripts require a root-owned
# approval file. Use always for strictly controlled production, never only in a
# disposable environment.
HENUKIT_REQUIRE_APPROVAL=high-risk
HENUKIT_ALLOW_FIRST_AUTO_DEPLOY=0

# Generic hook commands (used only when hooks.d/10-command is enabled).
# They execute from HENUKIT_RELEASE_DIR and receive the validated HENUKIT_*
# release environment. Keep these commands non-interactive and idempotent.
HENUKIT_PREPARE_COMMAND=
HENUKIT_ACTIVATE_COMMAND=
HENUKIT_VERIFY_COMMAND=
HENUKIT_ROLLBACK_COMMAND=

# Optional Study hook settings.
HENUKIT_STUDY_INCOMING_DIR=/opt/final-review-study/incoming
HENUKIT_STUDY_DEPLOY_COMMAND=/usr/local/bin/final-review-study-deploy
HENUKIT_STUDY_READY_URL=https://study.superhuazai.me/api/v1/readyz
HENUKIT_STUDY_WEB_URL=https://study.superhuazai.me/
HENUKIT_STUDY_PROBE_URL=https://study.superhuazai.me/deploy-probe.txt
