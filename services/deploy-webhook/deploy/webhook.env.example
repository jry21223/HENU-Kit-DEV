# Receiver configuration. Secrets are loaded through the systemd credential,
# not from this EnvironmentFile.
HENUKIT_WEBHOOK_LISTEN_ADDR=127.0.0.1:10087
HENUKIT_WEBHOOK_PATH=/webhooks/github
HENUKIT_WEBHOOK_REPOSITORY=jry21223/HENU-Kit-DEV
HENUKIT_WEBHOOK_BRANCH=main
HENUKIT_WEBHOOK_STATE_DIR=/var/lib/henukit-deploy-webhook
HENUKIT_WEBHOOK_MAX_BODY_BYTES=1048576
HENUKIT_WEBHOOK_MAX_QUEUE=100
HENUKIT_WEBHOOK_PROCESSED_RETENTION=720h

# Runner configuration.
HENUKIT_DEPLOY_COMMAND=/usr/local/libexec/henukit/henukit-deploy
HENUKIT_DEPLOY_TIMEOUT=45m
HENUKIT_DEPLOY_CONFIG=/etc/henukit-deploy/deploy.env
