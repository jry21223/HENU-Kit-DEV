# Root-only materials sync driver configuration. The unprivileged queue runner
# never reads this file; henukit-materials-root loads only the allowlisted keys.
# Install as /etc/henukit-deploy/materials-runner.env with mode 0600.

HENUKIT_MATERIALS_ROOT=/opt/henukit-materials
HENUKIT_MATERIALS_REPOSITORY=jry21223/HENU-Final-Review
HENUKIT_MATERIALS_REPO_URL=https://github.com/jry21223/HENU-Final-Review.git
HENUKIT_MATERIALS_REPO_REF=main
# Optional direct database connection. Keep credentials only in this root-only
# file; when unset, the driver enters postgres through the fixed release compose.
# HENUKIT_MATERIALS_DATABASE_URL=postgres://henukit:CHANGE_ME@127.0.0.1:5432/study?sslmode=disable
HENUKIT_MATERIALS_RELEASE_DIR=
# This copy lives below a root-owned, non-writable parent. Populate it from the
# production secret source before the first manual sync; do not point back into
# /opt/henukit, which is writable by the unprivileged deploy account.
HENUKIT_MATERIALS_ENV_FILE=/etc/henukit-deploy/materials-production.env
HENUKIT_MATERIALS_ACTIVE_SHA_FILE=/var/lib/henukit-actions-watch/last-activated-sha
