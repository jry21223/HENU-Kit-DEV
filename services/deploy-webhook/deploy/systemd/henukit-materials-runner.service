[Unit]
Description=Run queued HENU Kit materials syncs
Documentation=https://github.com/jry21223/HENU-Kit-DEV/blob/main/docs/operations/henukit-materials-sync.md
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# The queue is receiver-owned and is always parsed as the unprivileged service
# account. A root-owned, argument-validating sudo target performs only the
# canonical mirror/slides/database transaction.
User=henukit-deploy
Group=henukit-deploy
EnvironmentFile=/etc/henukit-deploy/materials-webhook.env
Environment=HENUKIT_DEPLOY_COMMAND=/usr/local/libexec/henukit/henukit-materials-sudo
Environment=HENUKIT_DEPLOY_TIMEOUT=2h
Environment=HOME=/var/lib/henukit-deploy
ExecStart=/usr/local/bin/henukit-deploy-webhook run
TimeoutStartSec=2h
UMask=0027
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=6
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/var/lib/henukit-materials-webhook /opt/henukit-materials
