[Unit]
Description=Watch HENU Kit materials candidate webhook queue
After=henukit-materials-webhook.service

[Path]
PathExists=/var/lib/henukit-materials-webhook/queue/latest.json
PathExists=/var/lib/henukit-materials-webhook/running.json
Unit=henukit-materials-runner.service

[Install]
WantedBy=multi-user.target
