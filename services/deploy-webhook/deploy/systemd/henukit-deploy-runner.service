[Unit]
Description=Run queued HENU Kit release deployments
Documentation=https://github.com/jry21223/HENU-Kit-DEV/tree/main/services/deploy-webhook
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=henukit-deploy
Group=henukit-deploy
EnvironmentFile=/etc/henukit-deploy/webhook.env
ExecStart=/usr/local/bin/henukit-deploy-webhook run
TimeoutStartSec=1h
UMask=0027
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=6
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=full
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
Environment=HOME=/var/lib/henukit-deploy

# The runner must write immutable release worktrees and may call narrowly scoped
# sudo commands from root-owned hooks. Keep the receiver itself fully confined.
ReadWritePaths=/var/lib/henukit-deploy-webhook /opt/henukit /run/lock
