{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://henukit.cn/schemas/events/event-envelope.schema.json",
  "title": "HENU Kit Business Event Envelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id",
    "event_type",
    "schema_version",
    "occurred_at",
    "producer",
    "resource",
    "data",
    "request_id"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "format": "uuid"
    },
    "event_type": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]*(\\.[a-z][a-z0-9_-]*)+$",
      "minLength": 3,
      "maxLength": 160
    },
    "schema_version": {
      "type": "integer",
      "minimum": 1
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["service_id"],
      "properties": {
        "service_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{1,99}$"
        }
      }
    },
    "subject_user_id": {
      "type": ["string", "null"],
      "format": "uuid"
    },
    "resource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id"],
      "properties": {
        "type": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{1,99}$"
        },
        "id": {
          "type": "string",
          "format": "uuid"
        }
      }
    },
    "data": {
      "type": "object"
    },
    "request_id": {
      "type": "string",
      "pattern": "^req_[A-Za-z0-9_-]+$",
      "maxLength": 128
    }
  }
}
