{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://henukit.cn/schemas/access-context.schema.json",
  "title": "HENU Kit Access Context",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "actor_type",
    "roles",
    "membership",
    "entitlements",
    "authorization_version"
  ],
  "properties": {
    "actor_type": {
      "type": "string",
      "enum": ["guest", "user", "service"]
    },
    "user_id": {
      "type": ["string", "null"],
      "format": "uuid"
    },
    "roles": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "scope_type", "scope_id"],
        "properties": {
          "code": {
            "type": "string",
            "enum": [
              "student",
              "creator",
              "reviewer",
              "operator",
              "admin",
              "super_admin"
            ]
          },
          "scope_type": {
            "type": "string",
            "enum": ["platform", "product", "organization", "course", "bank"]
          },
          "scope_id": {
            "type": ["string", "null"],
            "format": "uuid"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "scope_type": {"const": "platform"}
              },
              "required": ["scope_type"]
            },
            "then": {
              "properties": {
                "scope_id": {"type": "null"}
              }
            },
            "else": {
              "properties": {
                "scope_id": {"type": "string", "format": "uuid"}
              }
            }
          }
        ]
      }
    },
    "membership": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tier", "status", "expires_at"],
      "properties": {
        "tier": {
          "type": "string",
          "enum": ["free", "vip"]
        },
        "status": {
          "type": "string",
          "enum": ["active", "expired", "revoked"]
        },
        "expires_at": {
          "type": ["string", "null"],
          "format": "date-time"
        }
      }
    },
    "entitlements": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_.-]+$"
      }
    },
    "authorization_version": {
      "type": "integer",
      "minimum": 1
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "actor_type": {"const": "user"}
        },
        "required": ["actor_type"]
      },
      "then": {
        "required": ["user_id"],
        "properties": {
          "user_id": {"type": "string", "format": "uuid"}
        }
      }
    }
  ]
}
