{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "color": {
    "brand": {
      "accent": { "$value": "#FF4D00", "$type": "color" },
      "accent_deep": { "$value": "#D84300", "$type": "color" },
      "accent_soft": { "$value": "#FFE9DE", "$type": "color" }
    },
    "surface": {
      "paper": { "$value": "#F2F0EA", "$type": "color" },
      "raised": { "$value": "#FFFFFF", "$type": "color" },
      "line": { "$value": "rgba(22, 21, 19, 0.14)", "$type": "color" },
      "line_dark": { "$value": "rgba(242, 240, 234, 0.16)", "$type": "color" }
    },
    "text": {
      "primary": { "$value": "#161513", "$type": "color" },
      "muted": { "$value": "#6B6A66", "$type": "color" }
    },
    "semantic": {
      "success": { "$value": "#3E7C4F", "$type": "color" },
      "warning": { "$value": "#C79A2A", "$type": "color" },
      "danger": { "$value": "#C2401F", "$type": "color" },
      "info": { "$value": "#175CD3", "$type": "color" },
      "focus_ring": { "$value": "#FF4D00", "$type": "color" }
    }
  },
  "radius": {
    "control": { "$value": "4px", "$type": "dimension" },
    "card": { "$value": "4px", "$type": "dimension" },
    "feature": { "$value": "4px", "$type": "dimension" }
  },
  "motion": {
    "fast": { "$value": "120ms", "$type": "duration" },
    "normal": { "$value": "200ms", "$type": "duration" },
    "book_open": { "$value": "800ms", "$type": "duration" }
  }
}
