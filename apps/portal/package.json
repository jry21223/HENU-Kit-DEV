{
  "name": "@henukit/portal",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3001",
    "build": "next build && pnpm run test:library-public-artifact",
    "start": "next start -p 3001",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run src/lib/auth/display-name.test.ts src/lib/api/account-portfolio.test.ts src/lib/api/membership-order.test.ts src/lib/api/practice-session.test.ts src/lib/api/env.test.ts src/lib/food/ranking.test.ts src/lib/food/detail.test.ts",
    "test:unit": "node --experimental-strip-types --test src/components/practice/bank-hero-mastery.test.mjs src/components/account/account-console-boundary.test.mjs",
    "test:e2e:responsive": "playwright test tests/responsive.spec.ts tests/practice-leaderboard.spec.ts tests/quizcraft-catalog-dark.spec.ts",
    "test:e2e:food": "playwright test --workers=1 tests/food-ranking.spec.ts tests/food-detail.spec.ts tests/food-publish.spec.ts",
    "test:e2e:practice": "playwright test tests/practice-session.spec.ts",
    "test:e2e:quizcraft-catalog": "playwright test --config playwright.quizcraft-catalog.config.ts",
    "test:e2e:stats": "PLAYWRIGHT_ENABLE_QUIZCRAFT_V2_READS=1 playwright test tests/personal-stats.spec.ts",
    "test:e2e:account": "playwright test tests/account-portfolio.spec.ts tests/account-ticket-loop.spec.ts",
    "test:library-public-artifact": "node scripts/check-paid-library-public-artifact.mjs"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@radix-ui/react-label": "^2.1.13",
    "@radix-ui/react-slot": "^1.3.0",
    "@radix-ui/react-tabs": "^1.1.19",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "gsap": "^3.15.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.26.0",
    "next": "16.2.10",
    "qrcode": "^1.5.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-leaflet": "^5.0.0",
    "tailwind-merge": "^3.6.0",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@playwright/test": "1.61.0",
    "@tailwindcss/postcss": "^4",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.185.1",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "4.1.10"
  }
}
