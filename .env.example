APP_ENV=development

# PostgreSQL / Redis
DATABASE_URL=postgres://final_review:final_review_dev@localhost:5432/final_review_v2?sslmode=disable
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# API
API_PORT=8080
AUTO_MIGRATE=true
# Comma-separated exact origins. Do not use "*"; production requires HTTPS origins.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
RATE_LIMIT_RPS=20
RATE_LIMIT_BURST=40
OPERATION_LOG_RETENTION_DAYS=180
OPERATION_LOG_EXPORT_LIMIT=5000

# Auth, use mounted files or environment values outside development.
JWT_ISSUER=final-review-platform
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_HOURS=168
JWT_PRIVATE_KEY=
JWT_PRIVATE_KEY_PATH=
JWT_PUBLIC_KEY=
JWT_PUBLIC_KEY_PATH=

# Development only. Production must not use fixed verification codes.
DEV_FIXED_VERIFICATION_CODE=123456

# Frontends
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/api/v1
VITE_API_BASE_URL=http://localhost:8080/api/v1

# Storage
STORAGE_DRIVER=local
LOCAL_UPLOAD_DIR=uploads

# WeChat Pay Native. Mock is allowed only in development/test.
# In mock mode, WECHAT_PAY_API_V3_KEY may be a local fake secret and is required
# only for signing the mock notify callback. Never commit a real API v3 key.
WECHAT_PAY_MODE=mock
WECHAT_PAY_API_BASE_URL=https://api.mch.weixin.qq.com
WECHAT_PAY_APPID=
WECHAT_PAY_MCH_ID=
WECHAT_PAY_API_V3_KEY=
WECHAT_PAY_MERCHANT_SERIAL_NO=
WECHAT_PAY_MERCHANT_PRIVATE_KEY=
WECHAT_PAY_MERCHANT_PRIVATE_KEY_PATH=
WECHAT_PAY_PLATFORM_CERTS_DIR=
WECHAT_PAY_NOTIFY_URL=http://localhost:8080/api/v1/payments/wechat/notify
WECHAT_PAY_NATIVE_EXPIRE_MINUTES=15

# Optional best-effort alert for newly opened payment incidents.
# Payloads exclude raw WeChat notify content; set a secret to receive an
# X-Final-Review-Signature: sha256=... HMAC header.
PAYMENT_INCIDENT_WEBHOOK_URL=
PAYMENT_INCIDENT_WEBHOOK_SECRET=
PAYMENT_INCIDENT_WEBHOOK_TIMEOUT_SECONDS=3

# LLM. Mock is the default for local V2 skeleton work.
LLM_MODE=mock
AI_TASK_STREAM=ai_tasks
WORKER_HEALTH_PORT=9090
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# Internal smoke checks.
SMOKE_API_BASE_URL=http://localhost:8080/api/v1
SMOKE_EMAIL=smoke@stu.henu.edu.cn
SMOKE_CODE=123456
SMOKE_ADMIN_EMAIL=admin@example.com
SMOKE_ADMIN_CODE=123456
SMOKE_PACKAGE_ID=
SMOKE_CREATE_ORDER=false
SMOKE_MOCK_WECHAT_PAY=false
SMOKE_MOCK_WECHAT_SECRET=
SMOKE_GRANT_PACKAGE_ACCESS=false
SMOKE_SKIP_LOGIN=false
SMOKE_EXPECT_PAID_DENIED=true
SMOKE_TIMEOUT_SECONDS=15

# Browser E2E delivery smoke. Disabled by default because it mutates access grants.
E2E_DELIVERY_SMOKE=0
E2E_MOCK_PAYMENT_SMOKE=0
E2E_MOCK_PAYMENT_SECRET=
E2E_WEB_BASE_URL=http://127.0.0.1:3000
E2E_ADMIN_BASE_URL=http://127.0.0.1:5173
E2E_API_BASE_URL=http://127.0.0.1:8080/api/v1
E2E_STUDENT_EMAIL=smoke-browser@stu.henu.edu.cn
E2E_STUDENT_CODE=123456
E2E_ADMIN_EMAIL=admin@example.com
E2E_ADMIN_CODE=123456
E2E_PACKAGE_ID=
